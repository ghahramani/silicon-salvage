++static void zx_sw_apply(struct zx_eth_adapter *adapter)
++{
++	struct net_device *br[ZX_NUM_PORTS] = {};
++	void __iomem *base = adapter->base;
++	u8 egress[ZX_NUM_PORTS] = {};
++	u8 members = 0;
++	u32 vlan = 0;
++	int i, j;
