++static int zx_spinand_mtd_read_oob(struct mtd_info *mtd, loff_t from,
++				   struct mtd_oob_ops *ops)
++{
++	struct zx_spinand *sn = mtd->priv;
++	unsigned int max_bitflips = 0;
++	bool ecc_failed = false;
++	int ret = 0;
++	u8 ecc;
++
++	ops->retlen = 0;
++	ops->oobretlen = 0;
++
++	if (from < 0 || from >= mtd->size)
++		return -EINVAL;
++
++	mutex_lock(&sn->lock);
++
++	/* Data read */
++	if (ops->datbuf) {
++		u8 *dst = ops->datbuf;
++		size_t len = ops->len;
++		u32 addr = (u32)from;
++
++		while (len > 0) {
++			u32 page = addr / SPINAND_PAGE_SIZE;
++			u32 page_off = addr % SPINAND_PAGE_SIZE;
++			size_t chunk = min_t(size_t, SPINAND_PAGE_SIZE - page_off, len);
++
++			ret = zx_spinand_read_page(sn, page, &ecc);
++			if (ret)
++				break;
++			switch (ecc) {
++			case 0:
++				break;
++			case 1:		/* corrected, below the refresh threshold */
++				mtd->ecc_stats.corrected += mtd->ecc_strength / 2;
++				max_bitflips = max(max_bitflips, mtd->ecc_strength / 2);
++				break;
++			case 3:		/* corrected, refresh recommended */
++				mtd->ecc_stats.corrected += mtd->ecc_strength;
++				max_bitflips = max(max_bitflips, mtd->ecc_strength);
++				break;
++			default:	/* uncorrectable: pass the data on as read */
++				mtd->ecc_stats.failed++;
++				ecc_failed = true;
++				break;
++			}
++			memcpy(dst, sn->pagebuf + page_off, chunk);
++			dst += chunk;
++			addr += chunk;
++			len -= chunk;
++			ops->retlen += chunk;
++		}
++	}
++
++	/* OOB read */
++	if (!ret && ops->oobbuf) {
++		u8 *oobdst = ops->oobbuf;
++		size_t ooblen = ops->ooblen;
++		u32 page = (u32)from / SPINAND_PAGE_SIZE;
++		size_t oobavail = mtd_oobavail(mtd, ops);
++		uint32_t ooboffs = ops->ooboffs;
++
++		while (ooblen > 0 && page < SPINAND_TOTAL_PAGES) {
++			size_t toread = min_t(size_t, ooblen, oobavail - ooboffs);
++
++			ret = zx_spinand_read_oob_raw(sn, page, sn->oobbuf);
++			if (ret)
++				break;
++
++			if (ops->mode == MTD_OPS_AUTO_OOB) {
++				ret = mtd_ooblayout_get_databytes(mtd, oobdst, sn->oobbuf,
++								  ooboffs, toread);
++				if (ret)
++					break;
++			} else {
++				memcpy(oobdst, sn->oobbuf + ooboffs, toread);
++			}
++
++			oobdst += toread;
++			ooblen -= toread;
++			ops->oobretlen += toread;
++			ooboffs = 0;
++			page++;
++		}
++	}
++
++	mutex_unlock(&sn->lock);
++	if (ret)
++		return ret;
++	/* The OOB free bytes are not ECC protected: only data reads report */
++	return ecc_failed ? -EBADMSG : max_bitflips;
++}
++
++static int zx_spinand_mtd_write_oob(struct mtd_info *mtd, loff_t to,
++				    struct mtd_oob_ops *ops)
++{
++	struct zx_spinand *sn = mtd->priv;
++	int ret = 0;
++
++	ops->retlen = 0;
++	ops->oobretlen = 0;
++
++	if (to < 0 || to >= mtd->size)
++		return -EINVAL;
++
++	/* Safety boundary: protect bootloader (< 0x00700000) and Slot 1 (>= 0x02200000) */
++	if (to < 0x00700000 || (to + ops->len) > 0x02200000) {
++		pr_err("zx_spinand: write outside Slot 0 (0x%llx - 0x%llx) rejected\n",
++		       (u64)to, (u64)(to + ops->len));
++		return -EPERM;
++	}
++
++	mutex_lock(&sn->lock);
++
++	/* Data write */
++	if (ops->datbuf) {
++		const u8 *src = ops->datbuf;
++		size_t len = ops->len;
++		u32 addr = (u32)to;
++
++		while (len > 0) {
++			u32 page = addr / SPINAND_PAGE_SIZE;
++			u32 page_off = addr % SPINAND_PAGE_SIZE;
++			size_t chunk = min_t(size_t, SPINAND_PAGE_SIZE - page_off, len);
++
++			/*
++			 * A page is programmed once per erase: merging into a
++			 * programmed page would program it again and break its
++			 * on-die ECC parity.
++			 */
++			if (page_off != 0 || chunk != SPINAND_PAGE_SIZE) {
++				ret = -EINVAL;
++				break;
++			}
++			memcpy(sn->writebuf, src, SPINAND_PAGE_SIZE);
++			ret = zx_spinand_write_page(sn, page, sn->writebuf);
++
++			if (ret)
++				break;
++			src += chunk;
++			addr += chunk;
++			len -= chunk;
++			ops->retlen += chunk;
++		}
++	}
++
++	/* OOB write */
++	if (!ret && ops->oobbuf) {
++		const u8 *oobsrc = ops->oobbuf;
++		size_t ooblen = ops->ooblen;
++		u32 page = (u32)to / SPINAND_PAGE_SIZE;
++		size_t oobavail = mtd_oobavail(mtd, ops);
++		uint32_t ooboffs = ops->ooboffs;
++
++		while (ooblen > 0 && page < SPINAND_TOTAL_PAGES) {
++			size_t towrite = min_t(size_t, ooblen, oobavail - ooboffs);
++
++			memset(sn->oobbuf, 0xff, SPINAND_OOB_SIZE);
++			if (ops->mode == MTD_OPS_AUTO_OOB) {
++				ret = mtd_ooblayout_set_databytes(mtd, oobsrc, sn->oobbuf,
++								  ooboffs, towrite);
++				if (ret)
++					break;
++			} else {
++				memcpy(sn->oobbuf + ooboffs, oobsrc, towrite);
++			}
++
++			ret = zx_spinand_write_oob_raw(sn, page, sn->oobbuf);
++			if (ret)
++				break;
++
++			oobsrc += towrite;
++			ooblen -= towrite;
++			ops->oobretlen += towrite;
++			ooboffs = 0;
++			page++;
++		}
++	}
++
++	mutex_unlock(&sn->lock);
++	return ret;
++}
++
++static int zx_spinand_mtd_read(struct mtd_info *mtd, loff_t from, size_t len,
++				size_t *retlen, u_char *buf)
++{
++	struct mtd_oob_ops ops = {
++		.len = len,
++		.datbuf = buf,
++	};
++	int ret = zx_spinand_mtd_read_oob(mtd, from, &ops);
++	*retlen = ops.retlen;
++	return ret;
++}
++
++static int zx_spinand_mtd_write(struct mtd_info *mtd, loff_t to, size_t len,
++				size_t *retlen, const u_char *buf)
++{
++	struct mtd_oob_ops ops = {
++		.len = len,
++		.datbuf = (u8 *)buf,
++	};
++	int ret = zx_spinand_mtd_write_oob(mtd, to, &ops);
++	*retlen = ops.retlen;
++	return ret;
++}
++
++static int zx_spinand_mtd_erase(struct mtd_info *mtd, struct erase_info *instr)
++{
++	struct zx_spinand *sn = mtd->priv;
++	u32 addr, len;
++	int ret = 0;
++
++	if (instr->addr > mtd->size || instr->len > mtd->size ||
++	    instr->addr + instr->len > mtd->size)
++		return -EINVAL;
++
++	addr = (u32)instr->addr;
++	len = (u32)instr->len;
++
++	if (addr % mtd->erasesize || len % mtd->erasesize)
++		return -EINVAL;
++
++	/* Safety boundary: protect bootloader (< 0x00700000) and Slot 1 (>= 0x02200000) */
++	if (addr < 0x00700000 || (addr + len) > 0x02200000) {
++		pr_err("zx_spinand: erase outside Slot 0 (0x%08x - 0x%08x) rejected\n",
++		       addr, addr + len);
++		return -EPERM;
++	}
++
++	mutex_lock(&sn->lock);
++	while (len > 0) {
++		u32 lpage = addr / SPINAND_PAGE_SIZE;
++		u32 phys_page = zx_spinand_map_page(sn, lpage);
++		u32 pblock = phys_page / SPINAND_PAGES_PER_BLOCK;
++
++		ret = zx_spinand_erase_block(sn, pblock);
++		if (ret) {
++			instr->fail_addr = addr;
++			break;
++		}
++		addr += mtd->erasesize;
++		len -= mtd->erasesize;
++	}
++	mutex_unlock(&sn->lock);
++
++	return ret;
++}
++
++static int zx_spinand_mtd_block_isbad(struct mtd_info *mtd, loff_t ofs)
++{
++	struct zx_spinand *sn = mtd->priv;
++	u32 lblock = ofs / SPINAND_ERASE_SIZE;
++
++	if (lblock >= SPINAND_TOTAL_BLOCKS)
++		return -EINVAL;
++	/*
++	 * Offsets are logical: zx_spinand_map_page() already skips the bad
++	 * blocks, so every logical block below the good-block count maps to a
++	 * good one.  Only the tail that has no good block left is bad.
++	 */
++	return lblock >= sn->good_blocks;
++}
++
++static int zx_spinand_probe(struct platform_device *pdev)
++{
++	struct zx_spinand *sn;
++	u8 maker, device;
++	u32 reg24, b;
++	int ret;
++
++	sn = devm_kzalloc(&pdev->dev, sizeof(*sn), GFP_KERNEL);
++	if (!sn)
++		return -ENOMEM;
++
++	sn->base = devm_platform_ioremap_resource(pdev, 0);
++	if (IS_ERR(sn->base))
++		return PTR_ERR(sn->base);
++
++	sn->pagebuf = devm_kzalloc(&pdev->dev, SPINAND_PAGE_SIZE, GFP_KERNEL);
++	if (!sn->pagebuf)
++		return -ENOMEM;
++
++	sn->writebuf = devm_kzalloc(&pdev->dev, SPINAND_PAGE_SIZE, GFP_KERNEL);
++	if (!sn->writebuf)
++		return -ENOMEM;
++
++	sn->oobbuf = devm_kzalloc(&pdev->dev, SPINAND_OOB_SIZE, GFP_KERNEL);
++	if (!sn->oobbuf)
++		return -ENOMEM;
++
++	mutex_init(&sn->lock);
++
++	/* Set timing/sampling bit 16 in SPIFC_REG24 as U-Boot does */
++	reg24 = readl(sn->base + SPIFC_REG24);
++	writel((reg24 & ~0x30000) | 0x10000, sn->base + SPIFC_REG24);
++
++	ret = zx_spinand_reset(sn);
++	if (ret)
++		return dev_err_probe(&pdev->dev, ret, "RESET transaction failed\n");
++
++	ret = zx_spinand_read_id(sn, &maker, &device);
++	if (ret)
++		return dev_err_probe(&pdev->dev, ret, "READID transaction failed\n");
++	if (maker != SPINAND_MANUFACTURER_ID || device != SPINAND_DEVICE_ID)
++		return dev_err_probe(&pdev->dev, -ENODEV,
++				      "unexpected SPI NAND ID %02x:%02x (expected %02x:%02x)\n",
++				      maker, device, SPINAND_MANUFACTURER_ID, SPINAND_DEVICE_ID);
++
++	/* Identify bad blocks and build bad block map */
++	bitmap_zero(sn->bad_blocks, SPINAND_TOTAL_BLOCKS);
++	for (b = 0; b < SPINAND_TOTAL_BLOCKS; b++) {
++		if (zx_spinand_is_block_bad(sn, b)) {
++			set_bit(b, sn->bad_blocks);
++			dev_info(&pdev->dev, "Skipping bad block %u (0x%08x)\n",
++				 b, b * SPINAND_ERASE_SIZE);
++		}
++	}
++	sn->good_blocks = SPINAND_TOTAL_BLOCKS -
++			  bitmap_weight(sn->bad_blocks, SPINAND_TOTAL_BLOCKS);
++
++	sn->mtd.name = "zx279128s-spinand";
++	sn->mtd.type = MTD_NANDFLASH;
++	sn->mtd.flags = MTD_CAP_NANDFLASH;
++	sn->mtd.size = SPINAND_TOTAL_SIZE;
++	sn->mtd.erasesize = SPINAND_ERASE_SIZE;
++	sn->mtd.writesize = SPINAND_PAGE_SIZE;
++	sn->mtd.oobsize = SPINAND_OOB_SIZE;
++	sn->mtd.owner = THIS_MODULE;
++	sn->mtd.priv = sn;
++	sn->mtd._read = zx_spinand_mtd_read;
++	sn->mtd._write = zx_spinand_mtd_write;
++	sn->mtd._read_oob = zx_spinand_mtd_read_oob;
++	sn->mtd._write_oob = zx_spinand_mtd_write_oob;
++	sn->mtd._erase = zx_spinand_mtd_erase;
++	sn->mtd._block_isbad = zx_spinand_mtd_block_isbad;
++	mtd_set_ooblayout(&sn->mtd, &hyf1gq4_ooblayout);
++	sn->mtd.oobavail = mtd_ooblayout_count_freebytes(&sn->mtd);
++	sn->mtd.ecc_strength = 4;
++	sn->mtd.ecc_step_size = 512;
++	sn->mtd.bitflip_threshold = 3;
++	sn->mtd.dev.parent = &pdev->dev;
++	mtd_set_of_node(&sn->mtd, pdev->dev.of_node);
++
++	ret = mtd_device_register(&sn->mtd, NULL, 0);
++	if (ret)
++		return dev_err_probe(&pdev->dev, ret, "failed to register mtd device\n");
++
++	platform_set_drvdata(pdev, sn);
++	dev_info(&pdev->dev, "ZX279128S SPI NAND registered (%llu MiB, id %02x:%02x, write/erase enabled)\n",
++		 sn->mtd.size >> 20, maker, device);
++
++	return 0;
++}
++
++static void zx_spinand_remove(struct platform_device *pdev)
++{
++	struct zx_spinand *sn = platform_get_drvdata(pdev);
++
++	mtd_device_unregister(&sn->mtd);
++}
++
++static const struct of_device_id zx_spinand_of_match[] = {
++	{ .compatible = "zte,zx279128s-spinand" },
++	{ }
++};
++MODULE_DEVICE_TABLE(of, zx_spinand_of_match);
++
++static struct platform_driver zx_spinand_driver = {
++	.probe = zx_spinand_probe,
++	.remove = zx_spinand_remove,
++	.driver = {
++		.name = "zx279128s-spinand",
++		.of_match_table = zx_spinand_of_match,
++	},
++};
++module_platform_driver(zx_spinand_driver);
++
++MODULE_LICENSE("GPL");
++MODULE_DESCRIPTION("SPI NAND driver for ZTE ZX279128S SPIFC with bad-block skipping and write/erase support");
diff --git a/target/linux/sanechips/patches-6.18/009-arm-l2c-serialize-device-reads-with-maintenance.patch b/target/linux/sanechips/patches-6.18/009-arm-l2c-serialize-device-reads-with-maintenance.patch
new file mode 100644
index 0000000000..88d60320c7
--- /dev/null
+++ b/target/linux/sanechips/patches-6.18/009-arm-l2c-serialize-device-reads-with-maintenance.patch
@@ -0,0 +1,195 @@
+From: Navid Ghahremani <ghahramani.navid@gmail.com>
+Subject: [PATCH] ARM: l2c: optionally serialize device reads with L2C-310
+ maintenance
+
+On the ZTE/Sanechips ZX279128S a CPU read from a PCIe endpoint that is
+still outstanding when an L2C-310 range or sync operation is issued
+deadlocks the SoC.  Both CPUs stall on their next device access, no
+completion timeout fires, and only a watchdog reset recovers.  With an
+MT7915 behind the PCIe root port this hits within seconds of firmware
+download, because every chunk is DMA-mapped (L2 clean + sync) on one CPU
+while the other one reads the interrupt and ring registers.
+
+The vendor kernel avoids it by holding one spinlock around the L2C
+maintenance operations and around every PCIe register read of its Wi-Fi
+driver (fixed_pci_read_u32()).  Do the same here, opt-in through the
+"zte,l2c-io-read-lock" property on the cache controller node:
+
+ - wrap the L2C-310 inv/clean/flush range and sync operations with a
+   raw spinlock, and
+ - export outer_io_lock()/outer_io_unlock() so drivers can take the same
+   lock around their device reads.  Without CONFIG_CACHE_L2X0_IO_LOCK
+   these are empty inline stubs.
+
+Both kinds of operation need the lock.  In a firmware download stress
+test (MT7915 module reloaded 30 times per round, watchdog-guarded) the
+board froze within 1-9 reloads without the lock, froze in the first
+round with only the range operations locked, froze in the third round
+with only the standalone sync (wmb()/mb()) locked, and completed 240
+reloads without a freeze with both locked.
+
+Signed-off-by: Navid Ghahremani <ghahramani.navid@gmail.com>
+---
+--- a/arch/arm/include/asm/outercache.h
++++ b/arch/arm/include/asm/outercache.h
+@@ -117,4 +117,26 @@ static inline void outer_resume(void) {
+ 
+ #endif
+ 
++#ifdef CONFIG_CACHE_L2X0_IO_LOCK
++/**
++ * outer_io_lock - serialize a device read with outer cache maintenance
++ *
++ * On some SoCs a device read that is still outstanding while an outer
++ * cache range or sync operation is issued deadlocks the interconnect.
++ * Drivers for devices behind such a bus take this lock around their
++ * register reads.  It is a no-op unless the platform enabled it.
++ *
++ * Returns the saved interrupt flags to pass to outer_io_unlock().
++ */
++unsigned long outer_io_lock(void);
++void outer_io_unlock(unsigned long flags);
++#else
++static inline unsigned long outer_io_lock(void)
++{
++	return 0;
++}
++
++static inline void outer_io_unlock(unsigned long flags) { }
++#endif
++
+ #endif	/* __ASM_OUTERCACHE_H */
+--- a/arch/arm/mm/cache-l2x0.c
++++ b/arch/arm/mm/cache-l2x0.c
+@@ -48,6 +48,7 @@ struct l2x0_regs l2x0_saved_regs;
+ 
+ static bool l2x0_bresp_disable;
+ static bool l2x0_flz_disable;
++static bool l2x0_io_lock_enable;
+ 
+ /*
+  * Common code for all cache controllers.
+@@ -778,6 +779,81 @@ static const struct l2c_init_data l2c310
+ 	},
+ };
+ 
++#ifdef CONFIG_CACHE_L2X0_IO_LOCK
++/*
++ * On some SoCs (e.g. the ZTE/Sanechips ZX279128S) a CPU read from a PCIe
++ * endpoint that is still outstanding when an L2C maintenance or sync
++ * operation is issued deadlocks the interconnect: both CPUs stall and only
++ * a watchdog reset recovers.  The vendor kernel avoids this by holding one
++ * spinlock around the L2C operations and around the drivers' device reads.
++ * Do the same when the cache node asks for it.  Drivers take the lock
++ * around their device reads with outer_io_lock()/outer_io_unlock().
++ */
++static DEFINE_RAW_SPINLOCK(l2x0_io_lock);
++static struct outer_cache_fns l2x0_io_fns __ro_after_init;
++static bool l2x0_io_lock_active __ro_after_init;
++
++unsigned long outer_io_lock(void)
++{
++	unsigned long flags = 0;
++
++	if (l2x0_io_lock_active)
++		raw_spin_lock_irqsave(&l2x0_io_lock, flags);
++	return flags;
++}
++EXPORT_SYMBOL_GPL(outer_io_lock);
++
++void outer_io_unlock(unsigned long flags)
++{
++	if (l2x0_io_lock_active)
++		raw_spin_unlock_irqrestore(&l2x0_io_lock, flags);
++}
++EXPORT_SYMBOL_GPL(outer_io_unlock);
++
++#define L2C_IO_LOCKED_RANGE_OP(op)					\
++static void l2c_io_locked_##op(unsigned long start, unsigned long end)	\
++{									\
++	unsigned long flags;						\
++									\
++	raw_spin_lock_irqsave(&l2x0_io_lock, flags);			\
++	l2x0_io_fns.op(start, end);					\
++	raw_spin_unlock_irqrestore(&l2x0_io_lock, flags);		\
++}
++
++L2C_IO_LOCKED_RANGE_OP(inv_range)
++L2C_IO_LOCKED_RANGE_OP(clean_range)
++L2C_IO_LOCKED_RANGE_OP(flush_range)
++
++static void l2c_io_locked_sync(void)
++{
++	unsigned long flags;
++
++	raw_spin_lock_irqsave(&l2x0_io_lock, flags);
++	l2x0_io_fns.sync();
++	raw_spin_unlock_irqrestore(&l2x0_io_lock, flags);
++}
++
++static void __init l2c_io_lock_install(struct outer_cache_fns *fns)
++{
++	l2x0_io_fns = *fns;
++	if (fns->inv_range)
++		fns->inv_range = l2c_io_locked_inv_range;
++	if (fns->clean_range)
++		fns->clean_range = l2c_io_locked_clean_range;
++	if (fns->flush_range)
++		fns->flush_range = l2c_io_locked_flush_range;
++	if (fns->sync)
++		fns->sync = l2c_io_locked_sync;
++	l2x0_io_lock_active = true;
++	pr_info("L2C: serializing device reads with maintenance operations\n");
++}
++#else
++static void __init l2c_io_lock_install(struct outer_cache_fns *fns)
++{
++	pr_warn("L2C: io read lock requested but CONFIG_CACHE_L2X0_IO_LOCK is disabled\n");
++}
++#endif
++
+ static int __init __l2c_init(const struct l2c_init_data *data,
+ 			     u32 aux_val, u32 aux_mask, u32 cache_id, bool nosync)
+ {
+@@ -859,6 +935,8 @@ static int __init __l2c_init(const struc
+ 		pr_info("L2C: disabling outer sync\n");
+ 		fns.sync = NULL;
+ 	}
++	if (l2x0_io_lock_enable)
++		l2c_io_lock_install(&fns);
+ 
+ 	/*
+ 	 * Check if l2x0 controller is already enabled.  If we are booting
+@@ -1198,6 +1276,9 @@ static void __init l2c310_of_parse(const
+ 	if (of_property_read_bool(np, "arm,full-line-zero-disable"))
+ 		l2x0_flz_disable = true;
+ 
++	if (of_property_read_bool(np, "zte,l2c-io-read-lock"))
++		l2x0_io_lock_enable = true;
++
+ 	prefetch = l2x0_saved_regs.prefetch_ctrl;
+ 
+ 	ret = of_property_read_u32(np, "arm,double-linefill", &val);
+--- a/arch/arm/mm/Kconfig
++++ b/arch/arm/mm/Kconfig
+@@ -992,6 +992,20 @@ config CACHE_L2X0
+ 	help
+ 	  This option enables the L2x0 PrimeCell.
+ 
++config CACHE_L2X0_IO_LOCK
++	bool "Serialize device reads with L2C-310 maintenance operations"
++	depends on CACHE_L2X0
++	help
++	  On some SoCs, for example the ZTE/Sanechips ZX279128S, issuing an
++	  L2C-310 range or sync operation while a CPU read from a PCIe
++	  endpoint is still outstanding deadlocks the interconnect.  This
++	  option lets the L2C-310 maintenance operations take a spinlock
++	  that drivers also hold around their device reads, through
++	  outer_io_lock()/outer_io_unlock().  It is only active when the
++	  cache controller node has the "zte,l2c-io-read-lock" property.
++
++	  If unsure, say N.
++
+ config CACHE_L2X0_PMU
+ 	bool "L2x0 performance monitor support" if CACHE_L2X0
+ 	depends on PERF_EVENTS
diff --git a/target/linux/sanechips/patches-6.18/010-zte-zx-eth-flow-offload.patch b/target/linux/sanechips/patches-6.18/010-zte-zx-eth-flow-offload.patch
new file mode 100644
index 0000000000..473922ed1c
--- /dev/null
+++ b/target/linux/sanechips/patches-6.18/010-zte-zx-eth-flow-offload.patch
@@ -0,0 +1,908 @@
+From: Navid Ghahremani <ghahramani.navid@gmail.com>
+Subject: [PATCH] net: ethernet: zte: zx279128: hardware flow offload
+
+The packet processor of the ZX279128S forwards established IPv4 TCP and
+UDP flows between switch ports without the CPU.  The classifier looks the
+5-tuple up in two hash banks (256 entries with a CRC-32 slot, 128 with a
+CRC-32C slot), the packet modifier rewrites the MACs, addresses, ports and
+TTL, and the entry sends the frame to its egress port.  Unknown flows
+still go to the CPU.  The table formats were taken from the stock
+firmware's NPU tables.
+
+Offer this through ndo_setup_tc(TC_SETUP_FT), so nftables flowtables with
+hardware offload use it.  While a flowtable is bound, routed frames must
+reach the classifier: the port MACs go into the switch's routed-MAC table
+and the IPv4 and destination-MAC traps are lifted.  IPv6, ARP and VLAN
+tagged frames stay trapped to the CPU.  IPv4 between two LAN hosts is not
+routed: the switch hands it to the CPU as unknown unicast and the Linux
+bridge forwards it, as without offload.
+
+The WAN is a plain switch port, so the hardware handles both directions
+of a connection as upstream: both are hashed with the upstream key header
+and each gets its own rewrite entry.  While offload is active, pure TCP
+ACKs are no longer trapped to the CPU (registered packet class for TCP
+without payload, trap reason 0x2c), so they hit the flow table too.
+
+Signed-off-by: Navid Ghahremani <ghahramani.navid@gmail.com>
+---
+--- a/drivers/net/ethernet/zte/zx279128-eth.c
++++ b/drivers/net/ethernet/zte/zx279128-eth.c
+@@ -37,6 +37,12 @@
+ #include <linux/hrtimer.h>
+ #include <linux/iopoll.h>
+ #include <linux/rtnetlink.h>
++#include <linux/unaligned.h>
++#include <linux/bitmap.h>
++#include <linux/ip.h>
++#include <linux/mutex.h>
++#include <linux/rhashtable.h>
++#include <net/flow_offload.h>
+ 
+ #define DRV_NAME		"zx279128-eth"
+ 
+@@ -51,6 +57,41 @@
+ #define ZX_SPA_TRAP_DMAC	0x1d41a0	/* 8 bytes per entry */
+ #define ZX_SPA_TRAP_PROTO	0x1d41c0
+ #define ZX_SPA_TRAP_ETH_TYPE	0x1d41c4	/* 4 x 16 bits, big end first */
++#define ZX_SPA_ONU_MAC		0x1d4120	/* 16 x 8 bytes: our MACs, routed */
++#define ZX_SPA_REG_PKT_TCP_ACK	BIT(4)		/* word 2: TCP without payload */
++
++/* Packet processor tables, reached through an indirect access window:
++ * command (index | table << 22 | read << 27), status bit 0 = idle, data.
++ * The classifier (CLA) has 17 data words, the packet modifier (PM) 8.
++ */
++#define ZX_CLA_BASE		0x38c000
++#define ZX_PM_BASE		0x39c000
++#define ZX_PP_IND_CMD		0x14
++#define ZX_PP_IND_STATUS	0x18
++#define ZX_PP_IND_DATA		0x1c
++#define ZX_PM_IND_DATA_HI	0x100	/* PM data words 4-7 */
++#define ZX_PP_IND_READ		BIT(27)
++
++#define ZX_CLA_EXTRA_INDEX	0	/* header fields each packet type extracts */
++#define ZX_CLA_EXTRA_RULE	1
++#define ZX_CLA_HASH0		2	/* 256 flow entries, CRC-32 slot */
++#define ZX_CLA_HASH1		3	/* 128 flow entries, CRC-32C slot */
++#define ZX_CLA_AGING		8	/* hit flags, bank 0 then bank 1 */
++#define ZX_PM_FLOW		0	/* rewrite of a flow */
++#define ZX_PM_NEXT_HOP		1	/* new destination IP and MAC */
++#define ZX_PM_CMD		3
++#define ZX_PM_SUB		6
++#define ZX_PM_SRC_MAC		12	/* source MAC of each subnet */
++#define ZX_PP_SNAT_IP(s)	(0x3a0400 + (s) * 4)	/* source IP of each subnet */
++
++#define ZX_PPE_HASH0_SIZE	256
++#define ZX_PPE_HASH_SIZE	(256 + 128)
++#define ZX_PPE_FLOWS		1024
++#define ZX_PPE_NEXT_HOPS	512
++#define ZX_PPE_SUBNETS		16
++/* IPv4 TCP/UDP: extract index 9 and its rule; hashed with this rule id */
++#define ZX_PPE_V4_INDEX		9
++#define ZX_PPE_V4_RULE		0x98
+ 
