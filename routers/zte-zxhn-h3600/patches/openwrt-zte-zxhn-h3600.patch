index 0000000000..416955f729
--- /dev/null
+++ b/target/linux/sanechips/dts/zx279128s-zte-zxhn-h3600.dts
@@ -0,0 +1,632 @@
+// SPDX-License-Identifier: GPL-2.0-only OR BSD-2-Clause
+/*
+ * ZTE ZXHN H3600 / H1600 (Sanechips ZX279128S, dual Cortex-A9)
+ * OpenWrt Device Tree for RAM initramfs bring-up
+ */
+
+/dts-v1/;
+
+#include <dt-bindings/gpio/gpio.h>
+#include <dt-bindings/input/input.h>
+#include <dt-bindings/interrupt-controller/arm-gic.h>
+
+/ {
+	#address-cells = <1>;
+	#size-cells = <1>;
+	model = "ZTE ZXHN H3600 / H1600";
+	compatible = "zte,zxhn-h3600", "zte,zx279128s";
+
+	chosen {
+		bootargs = "earlycon=zteuart,0x94404000 console=ttyAMA0,115200n8 root=/dev/mtdblock6 rootfstype=squashfs";
+		/* WAN TX mode hardcoded to 3 (directed egress) in driver */
+		stdout-path = "serial0:115200n8";
+	};
+
+	aliases {
+		serial0 = &serial0;
+		serial1 = &serial1;
+		ethernet0 = &gmac;
+		led-boot = &led_power_red;
+		led-failsafe = &led_power_red;
+		led-running = &led_power_green;
+		led-upgrade = &led_power_red;
+	};
+
+	memory@40000000 {
+		device_type = "memory";
+		reg = <0x40000000 0x20000000>; /* 512 MiB DDR3 */
+	};
+
+	reserved-memory {
+		#address-cells = <1>;
+		#size-cells = <1>;
+		ranges;
+
+		/*
+		 * The stock kernel reserves the top 38 MiB for the packet
+		 * processor (ZX_RESERVE_MEM_SIZE 0x2600000).  Keep Linux,
+		 * and in particular CMA / DMA-coherent buffers, out of it.
+		 */
+		pp_reserved: pp@5da00000 {
+			reg = <0x5da00000 0x2600000>;
+			no-map;
+		};
+	};
+
+	uartclk: clock-uart {
+		compatible = "fixed-clock";
+		#clock-cells = <0>;
+		clock-frequency = <25000000>;
+	};
+
+	apbclk: clock-apb {
+		compatible = "fixed-clock";
+		#clock-cells = <0>;
+		clock-frequency = <100000000>;
+	};
+
+	periphclk: clock-periph {
+		compatible = "fixed-clock";
+		#clock-cells = <0>;
+		clock-frequency = <500000000>;
+	};
+
+	cpus {
+		#address-cells = <1>;
+		#size-cells = <0>;
+		enable-method = "zte,zx279128-smp";
+
+		cpu@0 {
+			compatible = "arm,cortex-a9";
+			device_type = "cpu";
+			next-level-cache = <&l2cc>;
+			reg = <0>;
+		};
+
+		cpu@1 {
+			compatible = "arm,cortex-a9";
+			device_type = "cpu";
+			next-level-cache = <&l2cc>;
+			reg = <1>;
+		};
+	};
+
+	soc {
+		#address-cells = <1>;
+		#size-cells = <1>;
+		compatible = "simple-bus";
+		interrupt-parent = <&gic>;
+		ranges;
+
+		scu: scu@800000 {
+			compatible = "arm,cortex-a9-scu";
+			reg = <0x00800000 0x100>;
+		};
+
+		gic: interrupt-controller@801000 {
+			compatible = "arm,cortex-a9-gic";
+			#interrupt-cells = <3>;
+			interrupt-controller;
+			reg = <0x00801000 0x1000>,
+			      <0x00800100 0x0100>;
+		};
+
+		timer@800200 {
+			compatible = "arm,cortex-a9-global-timer";
+			reg = <0x00800200 0x20>;
+			interrupts = <GIC_PPI 11 0x301>;
+			clocks = <&periphclk>;
+		};
+
+		twd_timer: timer@800600 {
+			compatible = "arm,cortex-a9-twd-timer";
+			reg = <0x00800600 0x20>;
+			interrupts = <GIC_PPI 13 0x301>;
+			clocks = <&periphclk>;
+		};
+
+		watchdog@800620 {
+			compatible = "arm,cortex-a9-twd-wdt";
+			reg = <0x00800620 0x20>;
+			interrupts = <GIC_PPI 14 0x104>;
+			clocks = <&periphclk>;
+			status = "disabled";
+		};
+
+		/* Reset trigger traced from U-Boot's own working "reset" command
+		 * (do_reset -> reset_cpu -> writel(1, 0x94000044)); this is the
+		 * vendor's own tested mechanism, not a guess. */
+		sysctrl: syscon@94000000 {
+			compatible = "syscon";
+			reg = <0x94000000 0x100>;
+		};
+
+		reboot {
+			compatible = "syscon-reboot";
+			regmap = <&sysctrl>;
+			offset = <0x44>;
+			mask = <0x1>;
+			value = <0x1>;
+		};
+
+		l2cc: cache-controller@c00000 {
+			compatible = "arm,pl310-cache";
+			reg = <0x00c00000 0x1000>;
+			cache-unified;
+			cache-level = <2>;
+			arm,data-latency = <2 2 2>;
+			arm,tag-latency = <2 2 2>;
+			/*
+			 * Match the stock firmware (AUX_CTRL 0x76430001).  Without
+			 * shared-override the PL310 turns normal non-cacheable
+			 * shared accesses (dma_alloc_coherent buffers) into
+			 * cacheable ones, so devices and CPUs see stale data.
+			 */
+			arm,shared-override;
+			prefetch-data = <1>;
+			prefetch-instr = <1>;
+			arm,double-linefill = <1>;
+			arm,double-linefill-incr = <0>;
+			/*
+			 * A PCIe read that is still outstanding while an L2
+			 * maintenance or sync operation runs deadlocks this SoC
+			 * (the vendor kernel serializes the two with one lock).
+			 */
+			zte,l2c-io-read-lock;
+		};
+
+		iram@200800 {
+			compatible = "zte,iram";
+			reg = <0x00200800 0x1000>;
+			status = "okay";
+		};
+
+		serial0: serial@94404000 {
+			compatible = "zte,ZX279127-uart", "arm,pl011", "arm,primecell";
+			arm,primecell-periphid = <0x001feffe>;
+			reg = <0x94404000 0x1000>;
+			interrupts = <GIC_SPI 11 0x04>;
+			clocks = <&uartclk>, <&apbclk>;
+			clock-names = "uartclk", "apb_pclk";
+			status = "okay";
+		};
+
+		serial1: serial@94405000 {
+			compatible = "zte,ZX279127-uart", "arm,pl011", "arm,primecell";
+			arm,primecell-periphid = <0x001feffe>;
+			reg = <0x94405000 0x1000>;
+			interrupts = <GIC_SPI 12 0x04>;
+			clocks = <&uartclk>, <&apbclk>;
+			clock-names = "uartclk", "apb_pclk";
+			status = "okay";
+		};
+
+		gpio0: gpio@94407000 {
+			compatible = "zte,zx279128s-gpio";
+			reg = <0x94407000 0x40>;
+			gpio-controller;
+			#gpio-cells = <2>;
+			ngpios = <16>;
+			interrupt-controller;
+			#interrupt-cells = <2>;
+			interrupts = <GIC_SPI 17 0x04>;
+		};
+
+		gpio1: gpio@94407040 {
+			compatible = "zte,zx279128s-gpio";
+			reg = <0x94407040 0x40>;
+			gpio-controller;
+			#gpio-cells = <2>;
+			ngpios = <16>;
+			interrupt-controller;
+			#interrupt-cells = <2>;
+			interrupts = <GIC_SPI 18 0x04>;
+		};
+
+		gpio2: gpio@94407080 {
+			compatible = "zte,zx279128s-gpio";
+			reg = <0x94407080 0x40>;
+			gpio-controller;
+			#gpio-cells = <2>;
+			ngpios = <16>;
+			interrupt-controller;
+			#interrupt-cells = <2>;
+			interrupts = <GIC_SPI 19 0x04>;
+		};
+
+		gpio3: gpio@944070c0 {
+			compatible = "zte,zx279128s-gpio";
+			reg = <0x944070c0 0x40>;
+			gpio-controller;
+			#gpio-cells = <2>;
+			ngpios = <16>;
+			interrupt-controller;
+			#interrupt-cells = <2>;
+			interrupts = <GIC_SPI 20 0x04>;
+		};
+
+		gpio4: gpio@94407100 {
+			compatible = "zte,zx279128s-gpio";
+			reg = <0x94407100 0x40>;
+			gpio-controller;
+			#gpio-cells = <2>;
+			ngpios = <16>;
+			interrupt-controller;
+			#interrupt-cells = <2>;
+			interrupts = <GIC_SPI 21 0x04>;
+		};
+
+		gpio5: gpio@94407140 {
+			compatible = "zte,zx279128s-gpio";
+			reg = <0x94407140 0x40>;
+			gpio-controller;
+			#gpio-cells = <2>;
+			ngpios = <16>;
+			interrupt-controller;
+			#interrupt-cells = <2>;
+			interrupts = <GIC_SPI 22 0x04>;
+		};
+
+		/* USB2 host DesignWare HS OTG controller - disabled until CRM driver enabled */
+		usb0: usb@9000000 {
+			compatible = "zte,ZX279127-dwc2", "snps,dwc2";
+			reg = <0x09000000 0x10000>;
+			interrupts = <GIC_SPI 44 0x04>;
+			dr_mode = "host";
+			status = "disabled";
+		};
+
+		/* USB3 host DesignWare DWC3 - disabled until CRM driver enabled */
+		usb1: usb@9100000 {
+			compatible = "snps,dwc3";
+			reg = <0x09100000 0x100000>;
+			interrupts = <GIC_SPI 50 0x04>;
+			dr_mode = "host";
+			status = "disabled";
+		};
+
+		/* The flash chip is SPI NAND (HY HYF1GQ4UDACAE, manuid=0xc9
+		 * devid=0x21), not parallel/raw NAND - the Denali binding that
+		 * used to be here was never tested and confirmed wrong via
+		 * live disassembly + register-level tracing of the vendor
+		 * U-Boot. This is the real controller (register protocol
+		 * validated live: READID and page-read-to-cache both
+		 * confirmed against known-good values on real hardware). */
+		spifc: spifc@94406000 {
+			compatible = "zte,zx279128s-spinand";
+			reg = <0x94406000 0x1000>;
+			status = "okay";
+
+			partitions {
+				compatible = "fixed-partitions";
+				#address-cells = <1>;
+				#size-cells = <1>;
+
+				partition@0 {
+					label = "bootloader";
+					reg = <0x0000000 0x0100000>;
+					read-only;
+				};
+
+				partition@100000 {
+					label = "tag";
+					reg = <0x0100000 0x0100000>;
+					read-only;
+
+					nvmem-layout {
+						compatible = "fixed-layout";
+						#address-cells = <1>;
+						#size-cells = <1>;
+
+						/* LAN MAC of the stock firmware; the
+						 * next address is its 5 GHz radio's */
+						macaddr_tag_1e: macaddr@1e {
+							compatible = "mac-base";
+							reg = <0x1e 0x6>;
+							#nvmem-cell-cells = <1>;
+						};
+					};
+				};
+
+				partition@200000 {
+					label = "wifi";
+					reg = <0x0200000 0x0100000>;
+					read-only;
+				};
+
+				partition@300000 {
+					label = "usercfg";
+					reg = <0x0300000 0x0200000>;
+				};
+
+				partition@500000 {
+					label = "defcfg";
+					reg = <0x0500000 0x0200000>;
+				};
+
+				partition@700000 {
+					label = "kernel";
+					reg = <0x0700000 0x0360000>;
+				};
+
+				partition@a60000 {
+					label = "rootfs";
+					reg = <0x0a60000 0x1620000>;
+				};
+
+				partition@2080000 {
+					label = "trailer";
+					reg = <0x2080000 0x0020000>;
+				};
+
+				/*
+				 * The rest of the stock firmware's slot 0, up to
+				 * its slot 1 at 0x2700000 on the chip.  OpenWrt
+				 * does not use it, but the stock firmware may
+				 * leave its own slot-0 header here, which hides
+				 * ours from the bootloader; sysupgrade clears it.
+				 */
+				partition@20a0000 {
+					label = "trailer_gap";
+					reg = <0x20a0000 0x0640000>;
+				};
+			};
+		};
+
+		/*
+		 * PCIe Port 0 - MT7915 Wi-Fi 6 (2.4 GHz)
+		 * DBI at 0x0f000000, ctrl at 0x09500000, config space at 0x1c000000
+		 * Outbound memory window at 0x10000000 (128 MiB)
+		 * Reset GPIO: gpio3 pin 5 (GPIO 53)
+		 */
+		pcie0: pcie@f000000 {
+			compatible = "zte,zx279128s-pcie";
+			reg = <0x0f000000 0x4000>,   /* DBI registers */
+			      <0x09500000 0x1000>,   /* ctrl registers */
+			      <0x1c000000 0x200000>; /* config & PHY registers */
+			reg-names = "dbi", "ctrl", "config";
+			#address-cells = <3>;
+			#size-cells = <2>;
+			device_type = "pci";
+			bus-range = <0x00 0xff>;
+			ranges = <0x82000000 0 0x10000000  0x10000000  0 0x08000000>;
+			dma-ranges = <0x43000000 0x0 0x40000000  0x40000000  0 0x20000000>;
+			interrupts = <GIC_SPI 63 0x04>;
+			#interrupt-cells = <1>;
+			interrupt-map-mask = <0 0 0 7>;
+			interrupt-map = <0 0 0 1 &gic GIC_SPI 63 0x04>,
+					<0 0 0 2 &gic GIC_SPI 63 0x04>,
+					<0 0 0 3 &gic GIC_SPI 63 0x04>,
+					<0 0 0 4 &gic GIC_SPI 63 0x04>;
+			linux,pci-domain = <0>;
+			port-id = <0>;
+			reset-gpios = <&gpio3 5 GPIO_ACTIVE_HIGH>;
+			enable-gpios = <&gpio3 7 GPIO_ACTIVE_HIGH>;
+			status = "okay";
+		};
+
+		/*
+		 * PCIe Port 1 - MT7915 Wi-Fi 6 (5 GHz)
+		 * DBI at 0x0f100000, ctrl at 0x09600000, config space at 0x2c000000
+		 * Outbound memory window at 0x20000000 (128 MiB)
+		 * Reset is handled jointly by pcie0 (GPIO 53 and 55)
+		 */
+		pcie1: pcie@f100000 {
+			compatible = "zte,zx279128s-pcie";
+			reg = <0x0f100000 0x4000>,   /* DBI registers */
+			      <0x09600000 0x1000>,   /* ctrl registers */
+			      <0x2c000000 0x200000>; /* config & PHY registers */
+			reg-names = "dbi", "ctrl", "config";
+			#address-cells = <3>;
+			#size-cells = <2>;
+			device_type = "pci";
+			bus-range = <0x00 0xff>;
+			ranges = <0x82000000 0 0x20000000  0x20000000  0 0x08000000>;
+			dma-ranges = <0x43000000 0x0 0x40000000  0x40000000  0 0x20000000>;
+			interrupts = <GIC_SPI 78 0x04>;
+			#interrupt-cells = <1>;
+			interrupt-map-mask = <0 0 0 7>;
+			interrupt-map = <0 0 0 1 &gic GIC_SPI 78 0x04>,
+					<0 0 0 2 &gic GIC_SPI 78 0x04>,
+					<0 0 0 3 &gic GIC_SPI 78 0x04>,
+					<0 0 0 4 &gic GIC_SPI 78 0x04>;
+			linux,pci-domain = <1>;
+			port-id = <1>;
+			status = "okay";
+		};
+
+		mdio: mdio@9a101000 {
+			compatible = "zte,zx279128s-mdio";
+			reg = <0x9a101000 0x18>;
+			#address-cells = <1>;
+			#size-cells = <0>;
+			status = "okay";
+
+			phy8: ethernet-phy@8 {
+				reg = <8>;
+			};
+
+			phy10: ethernet-phy@10 {
+				reg = <10>;
+			};
+
+			phy11: ethernet-phy@11 {
+				reg = <11>;
+			};
+
+			phy12: ethernet-phy@12 {
+				reg = <12>;
+			};
+
+			phy13: ethernet-phy@13 {
+				reg = <13>;
+			};
+		};
+
+		gmac: ethernet@92000000 {
+			compatible = "zte,zx279128s-gmac";
+			reg = <0x92000000 0x400000>;
+			nvmem-cells = <&macaddr_tag_1e 0>;
+			nvmem-cell-names = "mac-address";
+			status = "okay";
+
+			/* One netdev per port; the switch does not forward
+			 * between ports.  reg is the switch port, label the
+			 * front panel name. */
+			ethernet-ports {
+				#address-cells = <1>;
+				#size-cells = <0>;
+
+				port@0 {
+					reg = <0>;
+					label = "lan1";
+					phy-handle = <&phy10>;
+				};
+
+				port@1 {
+					reg = <1>;
+					label = "lan2";
+					phy-handle = <&phy11>;
+				};
+
+				port@2 {
+					reg = <2>;
+					label = "lan3";
+					phy-handle = <&phy12>;
+				};
+
+				port@3 {
+					reg = <3>;
+					label = "lan4";
+					phy-handle = <&phy13>;
+				};
+
+				port@4 {
+					reg = <4>;
+					label = "wan";
+					phy-handle = <&phy8>;
+				};
+			};
+		};
+	};
+
+	/* LED GPIO mapping confirmed live by physically watching the front
+	 * panel while toggling each candidate GPIO one at a time - not
+	 * inferred from any schematic. All lines active-low (driving the
+	 * line low turns the LED on). No default triggers set - matches
+	 * every LED's real power-on state (off) and lets normal OpenWrt
+	 * userspace (/etc/config/system) assign triggers later, same as
+	 * any other device. Colors only asserted where directly confirmed;
+	 * the rest are left without a color-coded label. */
+	leds {
+		compatible = "gpio-leds";
+
+		/* Power LED, two elements: red on U-Boot gpio 38 and green on
+		 * gpio 39, both active low (both on shows orange). The stock
+		 * firmware boots red and turns green when it is up; the
+		 * led-boot/led-running aliases do the same. Confirmed on the
+		 * front panel. */
+		led_power_red: led-power-red {
+			label = "h3600:red:power";
+			gpios = <&gpio2 6 GPIO_ACTIVE_LOW>;
+			default-state = "on";
+		};
+
+		led_power_green: led-power-green {
+			label = "h3600:green:power";
+			gpios = <&gpio2 7 GPIO_ACTIVE_LOW>;
+		};
+
+		led-wifi2g {
+			label = "h3600:wifi2g";
+			gpios = <&gpio0 1 GPIO_ACTIVE_LOW>;
+		};
+
+		led-broadband {
+			label = "h3600:broadband";
+			gpios = <&gpio0 8 GPIO_ACTIVE_LOW>;
+		};
+
+		led-phone1 {
+			label = "h3600:green:phone1";
+			gpios = <&gpio1 12 GPIO_ACTIVE_LOW>;
+		};
+
+		led-phone2 {
+			label = "h3600:green:phone2";
+			gpios = <&gpio1 13 GPIO_ACTIVE_LOW>;
+		};
+
+		led-wifi5g {
+			label = "h3600:green:wifi5g";
+			gpios = <&gpio2 8 GPIO_ACTIVE_LOW>;
+		};
+
+		led-usb {
+			label = "h3600:green:usb";
+			gpios = <&gpio2 9 GPIO_ACTIVE_LOW>;
+		};
+
+		led-internet-red {
+			label = "h3600:red:internet";
+			gpios = <&gpio3 0 GPIO_ACTIVE_LOW>;
+		};
+
+		led-internet-green {
+			label = "h3600:green:internet";
+			gpios = <&gpio3 1 GPIO_ACTIVE_LOW>;
+		};
+
+		led-wps {
+			label = "h3600:wps";
+			gpios = <&gpio3 2 GPIO_ACTIVE_LOW>;
+		};
+	};
+
+	/* Button GPIO mapping confirmed live by press-and-hold with the
+	 * user while polling every input candidate for a transition. Three
+	 * other candidate lines (uboot gpio 5, 15, 47) never transitioned
+	 * for any button the unit actually has and are deliberately left
+	 * unmodeled rather than guessed at.
+	 *
+	 * Polled rather than interrupt-driven: the custom zx279133-gpio
+	 * IRQ chip (003-zte-zx-gpio.patch) is unvalidated on real hardware,
+	 * and a live test wiring these same lines through gpio-keys (irq
+	 * mode) triggered an RCU stall / full lockup on first button press
+	 * (root-caused to that IRQ chip, not to gpio-button-hotplug, which
+	 * requests a standard IRQF_ONESHOT threaded edge-both interrupt).
+	 * Polling avoids the untested IRQ path entirely; 50ms is plenty
+	 * responsive for physical buttons. */
+	keys {
+		compatible = "gpio-keys-polled";
+		poll-interval = <50>;
+
+		key-reset {
+			label = "reset";
+			gpios = <&gpio0 2 GPIO_ACTIVE_LOW>;
+			linux,code = <KEY_RESTART>;
+			debounce-interval = <60>;
+		};
+
+		key-wps {
+			label = "wps";
+			gpios = <&gpio0 12 GPIO_ACTIVE_LOW>;
+			linux,code = <KEY_WPS_BUTTON>;
+			debounce-interval = <60>;
+		};
+
+		key-wifi {
+			label = "rfkill";
+			gpios = <&gpio3 12 GPIO_ACTIVE_LOW>;
+			linux,code = <KEY_RFKILL>;
+			debounce-interval = <60>;
+		};
+
+		key-led {
+			label = "led";
+			gpios = <&gpio0 3 GPIO_ACTIVE_LOW>;
+			linux,code = <KEY_LIGHTS_TOGGLE>;
+			debounce-interval = <60>;
+		};
+	};
+};
diff --git a/target/linux/sanechips/generic/target.mk b/target/linux/sanechips/generic/target.mk
new file mode 100644
index 0000000000..333e480b86
--- /dev/null
+++ b/target/linux/sanechips/generic/target.mk
@@ -0,0 +1,3 @@
+ARCH:=arm
+BOARDNAME:=Generic
+CPU_TYPE:=cortex-a9
diff --git a/target/linux/sanechips/image/Makefile b/target/linux/sanechips/image/Makefile
new file mode 100644
index 0000000000..f638514059
--- /dev/null
+++ b/target/linux/sanechips/image/Makefile
@@ -0,0 +1,53 @@
+# SPDX-License-Identifier: GPL-2.0-only
+
+include $(TOPDIR)/rules.mk
+include $(INCLUDE_DIR)/image.mk
+
+# cspboot only boots a kernel that starts with the 32-byte ZTE slot marker.
+define Build/zte-slot-marker
+	( printf '\063\063\063\063\314\314\314\314\210\210\210\210\335\335\335\335'; \
+	  printf '\377\377\377\377\377\377\377\377\377\377\377\377\377\377\377\377'; \
+	  cat $@ ) > $@.new
+	mv $@.new $@
+endef
+
+# The initramfs image is started from U-Boot after a TFTP download.  U-Boot
+# leaves its Ethernet running, with its packet buffers at 0x41000000 and its
+# free-buffer list at 0x41800000.  A kernel unpacked at 0x40008000 lands on
+# top of them, and a frame that arrives during early boot makes the buffer
+# manager read kernel bytes as buffer numbers: it locks up (no RX, no TX)
+# and the hardware writes packet data into the kernel.  Load the initramfs
+# kernel at 0x48008000 instead (AUTO_ZRELADDR unpacks it there); the RAM
+# below 0x48000000 is left unused by this RAM-only system.
+define Build/uImage-ramboot
+	$(if $(UIMAGE_TIME),SOURCE_DATE_EPOCH="$(UIMAGE_TIME)") \
+	mkimage -A $(LINUX_KARCH) -O linux -T kernel -C none \
+		-a 0x48008000 -e 0x48008000 \
+		-n '$(call toupper,$(LINUX_KARCH)) $(VERSION_DIST) Linux-$(LINUX_VERSION)' \
+		-d $@ $@.new
+	mv $@.new $@
+endef
+
+define Device/Default
+  PROFILES := Default
+  DEVICE_VENDOR := ZTE
+  DEVICE_DTS_DIR := ../dts
+  KERNEL_LOADADDR := 0x40008000
+  KERNEL_ENTRY := 0x40008000
+  KERNEL_NAME := zImage
+  KERNEL := kernel-bin | append-dtb | uImage none | zte-slot-marker
+  KERNEL_SIZE := 3456k
+  KERNEL_INITRAMFS := kernel-bin | append-dtb | uImage-ramboot
+  KERNEL_INITRAMFS_SUFFIX := .uImage
+endef
+
+define Device/zte_zxhn-h3600
+  DEVICE_MODEL := ZXHN H3600 / H1600
+  DEVICE_DTS := zx279128s-zte-zxhn-h3600
+  DEVICE_PACKAGES := kmod-mt7915e kmod-mt7915-firmware kmod-usb3 kmod-usb-dwc3
+  IMAGES := sysupgrade.bin
+  IMAGE/sysupgrade.bin := sysupgrade-tar | append-metadata
+endef
+TARGET_DEVICES += zte_zxhn-h3600
+
+$(eval $(call BuildImage))
diff --git a/target/linux/sanechips/patches-6.18/001-zte-pl011-uart.patch b/target/linux/sanechips/patches-6.18/001-zte-pl011-uart.patch
new file mode 100644
index 0000000000..fbe43655b2
--- /dev/null
+++ b/target/linux/sanechips/patches-6.18/001-zte-pl011-uart.patch
@@ -0,0 +1,133 @@
+From: Navid Ghahremani <ghahramani.navid@gmail.com>
+Subject: [PATCH] serial: amba-pl011: add the ZTE ZX279128S UART
+
+The ZX279128S UART is a PL011 with the register layout of the ZTE ZX
+SoCs, 32-bit register access and a 16-byte FIFO.  Add a vendor entry for
+its peripheral ID and deassert its optional reset line at probe.
+
+Signed-off-by: Navid Ghahremani <ghahramani.navid@gmail.com>
+---
+--- a/drivers/tty/serial/amba-pl011.c
++++ b/drivers/tty/serial/amba-pl011.c
+@@ -38,6 +38,7 @@
+ #include <linux/types.h>
+ #include <linux/of.h>
+ #include <linux/pinctrl/consumer.h>
++#include <linux/reset.h>
+ #include <linux/sizes.h>
+ #include <linux/io.h>
+ #include <linux/acpi.h>
+@@ -201,6 +202,39 @@ static unsigned int get_fifosize_st(stru
+ 	return 64;
+ }
+ 
++
++static const u16 pl011_zte_offsets[REG_ARRAY_SIZE] = {
++	[REG_DR] = ZX_UART011_DR,
++	[REG_FR] = ZX_UART011_FR,
++	[REG_LCRH_RX] = ZX_UART011_LCRH,
++	[REG_LCRH_TX] = ZX_UART011_LCRH,
++	[REG_IBRD] = ZX_UART011_IBRD,
++	[REG_FBRD] = ZX_UART011_FBRD,
++	[REG_CR] = ZX_UART011_CR,
++	[REG_IFLS] = ZX_UART011_IFLS,
++	[REG_IMSC] = ZX_UART011_IMSC,
++	[REG_RIS] = ZX_UART011_RIS,
++	[REG_MIS] = ZX_UART011_MIS,
++	[REG_ICR] = ZX_UART011_ICR,
++	[REG_DMACR] = ZX_UART011_DMACR,
++};
++
++static unsigned int get_fifosize_zte(struct amba_device *dev)
++{
++	return 16;
++}
++
++static struct vendor_data vendor_zte = {
++	.reg_offset		= pl011_zte_offsets,
++	.ifls			= UART011_IFLS_RX4_8 | UART011_IFLS_TX4_8,
++	.fr_busy		= ZX_UART01x_FR_BUSY,
++	.fr_dsr			= ZX_UART01x_FR_DSR,
++	.fr_cts			= ZX_UART01x_FR_CTS,
++	.fr_ri			= ZX_UART011_FR_RI,
++	.access_32b		= true,
++	.get_fifosize		= get_fifosize_zte,
++};
++
+ static struct vendor_data vendor_st = {
+ 	.reg_offset		= pl011_st_offsets,
+ 	.ifls			= UART011_IFLS_RX_HALF | UART011_IFLS_TX_HALF,
+@@ -2670,6 +2704,31 @@ static void pl011_putc(struct uart_port
+ 		cpu_relax();
+ }
+ 
++
++static void zte_pl011_early_putc(struct uart_port *port, unsigned char c)
++{
++	while (readl(port->membase + ZX_UART011_FR) & UART01x_FR_TXFF)
++		cpu_relax();
++	writel(c, port->membase + ZX_UART011_DR);
++}
++
++static void zte_pl011_early_write(struct console *con, const char *s, unsigned int n)
++{
++	struct earlycon_device *dev = con->data;
++
++	uart_console_write(&dev->port, s, n, zte_pl011_early_putc);
++}
++
++static int __init zte_pl011_early_console_setup(struct earlycon_device *device,
++						const char *opt)
++{
++	if (!device->port.membase)
++		return -ENODEV;
++
++	device->con->write = zte_pl011_early_write;
++	return 0;
++}
++
+ static void pl011_early_write(struct console *con, const char *s, unsigned int n)
+ {
+ 	struct earlycon_device *dev = con->data;
+@@ -2736,6 +2795,12 @@ OF_EARLYCON_DECLARE(pl011, "arm,pl011",
+ 
+ OF_EARLYCON_DECLARE(pl011, "arm,sbsa-uart", pl011_early_console_setup);
+ 
++/* Keep this after the fallbacks: this object emits the table in reverse order. */
++OF_EARLYCON_DECLARE(zteuart, "zte,zx279133-uart", zte_pl011_early_console_setup);
++OF_EARLYCON_DECLARE(zteuart, "zte,ZX279127-uart", zte_pl011_early_console_setup);
++
++EARLYCON_DECLARE(zteuart, zte_pl011_early_console_setup);
++
+ /*
+  * On Qualcomm Datacenter Technologies QDF2400 SOCs affected by
+  * Erratum 44, traditional earlycon can be enabled by specifying
+@@ -2912,6 +2977,15 @@ static int pl011_probe(struct amba_devic
+ 	if (!uap)
+ 		return -ENOMEM;
+ 
++	if (vendor == &vendor_zte) {
++		struct reset_control *rst;
++
++		rst = devm_reset_control_get_optional_shared_deasserted(&dev->dev, NULL);
++		if (IS_ERR(rst))
++			return dev_err_probe(&dev->dev, PTR_ERR(rst),
++					     "failed to deassert reset\n");
++	}
++
+ 	uap->clk = devm_clk_get(&dev->dev, NULL);
+ 	if (IS_ERR(uap->clk))
+ 		return PTR_ERR(uap->clk);
+@@ -3129,6 +3203,12 @@ static const struct amba_id pl011_ids[]
+ 		.mask	= 0x00ffffff,
+ 		.data	= &vendor_st,
+ 	},
++	{
++		.id	= 0x001feffe,
++		.mask	= 0x00ffffff,
++		.data	= &vendor_zte,
++	},
++
+ 	{ 0, 0 },
+ };
+ 
diff --git a/target/linux/sanechips/patches-6.18/002-arm-global-timer.patch b/target/linux/sanechips/patches-6.18/002-arm-global-timer.patch
new file mode 100644
index 0000000000..674713bb30
--- /dev/null
+++ b/target/linux/sanechips/patches-6.18/002-arm-global-timer.patch
@@ -0,0 +1,54 @@
+From: Navid Ghahremani <ghahramani.navid@gmail.com>
+Subject: [PATCH] clocksource: make the ARM global timer selectable
+
+The ZX279128S (dual Cortex-A9) uses the ARM global timer as its clock
+source and sched_clock.  The target builds with ARCH_VIRT, which does
+not select it: make ARM_GLOBAL_TIMER user selectable and let ARCH_VIRT
+(and, as a workaround, ARCH_AIROHA and SOC_SP7021) select it and the
+TWD timer.  A proper ARCH_ZX279128S platform entry should replace this.
+
+Signed-off-by: Navid Ghahremani <ghahramani.navid@gmail.com>
+---
+--- a/arch/arm/Kconfig.platforms
++++ b/arch/arm/Kconfig.platforms
+@@ -66,6 +66,9 @@ config ARCH_VIRT
+ 	select ARM_GIC_V3_ITS if PCI
+ 	select ARM_PSCI
+ 	select HAVE_ARM_ARCH_TIMER
++	select ARM_GLOBAL_TIMER
++	select CLKSRC_ARM_GLOBAL_TIMER_SCHED_CLOCK
++	select HAVE_ARM_TWD if SMP
+ 
+ config ARCH_AIROHA
+ 	bool "Airoha SoC Support"
+@@ -75,6 +78,9 @@ config ARCH_AIROHA
+ 	select ARM_GIC_V3
+ 	select ARM_PSCI
+ 	select HAVE_ARM_ARCH_TIMER
++	select ARM_GLOBAL_TIMER
++	select CLKSRC_ARM_GLOBAL_TIMER_SCHED_CLOCK
++	select HAVE_ARM_TWD if SMP
+ 	help
+ 	  Support for Airoha EN7523 SoCs
+ 
+@@ -178,6 +184,9 @@ config SOC_SP7021
+ 	bool "Sunplus SP7021 SoC support"
+ 	default ARCH_SUNPLUS
+ 	select HAVE_ARM_ARCH_TIMER
++	select ARM_GLOBAL_TIMER
++	select CLKSRC_ARM_GLOBAL_TIMER_SCHED_CLOCK
++	select HAVE_ARM_TWD if SMP
+ 	select ARM_GIC
+ 	select ARM_PSCI
+ 	select PINCTRL
+--- a/drivers/clocksource/Kconfig
++++ b/drivers/clocksource/Kconfig
+@@ -388,7 +388,7 @@ config SUN50I_ERRATUM_UNKNOWN1
+ 	  allwinner,erratum-unknown1 property is found in the timer node.
+ 
+ config ARM_GLOBAL_TIMER
+-	bool "Support for the ARM global timer" if COMPILE_TEST
++	bool "Support for the ARM global timer"
+ 	select TIMER_OF if OF
+ 	depends on ARM
+ 	help
diff --git a/target/linux/sanechips/patches-6.18/003-zte-zx-gpio.patch b/target/linux/sanechips/patches-6.18/003-zte-zx-gpio.patch
new file mode 100644
index 0000000000..1913b76946
--- /dev/null
+++ b/target/linux/sanechips/patches-6.18/003-zte-zx-gpio.patch
@@ -0,0 +1,362 @@
+From: Navid Ghahremani <ghahramani.navid@gmail.com>
+Subject: [PATCH] gpio: add the ZTE ZX279128S GPIO controller
+
+Add a driver for the GPIO banks of the ZX279128S, used for the LEDs
+and buttons of the ZTE ZXHN H3600.
+
+Signed-off-by: Navid Ghahremani <ghahramani.navid@gmail.com>
+---
+--- a/drivers/gpio/Kconfig
++++ b/drivers/gpio/Kconfig
+@@ -749,6 +749,15 @@ config GPIO_TEGRA
+ 	help
+ 	  Say yes here to support GPIO pins on NVIDIA Tegra SoCs.
+ 
++config GPIO_ZX279133
++	tristate "ZTE ZX279128S / ZX279133 GPIO support"
++	depends on OF_GPIO
++	select GPIOLIB_IRQCHIP
++	default y
++	help
++	  Say yes here to support the GPIO controller found on ZTE
++	  ZX279128S and ZX279133 SoCs.
++
+ config GPIO_TEGRA186
+ 	tristate "NVIDIA Tegra186 GPIO support"
+ 	default ARCH_TEGRA_186_SOC || ARCH_TEGRA_194_SOC || ARCH_TEGRA_234_SOC
+--- a/drivers/gpio/Makefile
++++ b/drivers/gpio/Makefile
+@@ -218,3 +218,4 @@ obj-$(CONFIG_GPIO_XTENSA)		+= gpio-xtens
+ obj-$(CONFIG_GPIO_ZEVIO)		+= gpio-zevio.o
+ obj-$(CONFIG_GPIO_ZYNQ)			+= gpio-zynq.o
+ obj-$(CONFIG_GPIO_ZYNQMP_MODEPIN)	+= gpio-zynqmp-modepin.o
++obj-$(CONFIG_GPIO_ZX279133)		+= gpio-zx279133.o
+--- /dev/null
++++ b/drivers/gpio/gpio-zx279133.c
+@@ -0,0 +1,326 @@
++// SPDX-License-Identifier: GPL-2.0-only
++
++#include <linux/bitops.h>
++#include <linux/gpio/driver.h>
++#include <linux/interrupt.h>
++#include <linux/io.h>
++#include <linux/irq.h>
++#include <linux/irqchip/chained_irq.h>
++#include <linux/mod_devicetable.h>
++#include <linux/module.h>
++#include <linux/platform_device.h>
++#include <linux/property.h>
++#include <linux/spinlock.h>
++
++#define ZX279133_GPIO_DIR		0x00
++#define ZX279133_GPIO_IRQ_MODE		0x04
++#define ZX279133_GPIO_IRQ_LEVEL		0x08
++#define ZX279133_GPIO_IRQ_RISING		0x0c
++#define ZX279133_GPIO_IRQ_FALLING	0x10
++#define ZX279133_GPIO_DATA		0x14
++#define ZX279133_GPIO_SET		0x18
++#define ZX279133_GPIO_CLEAR		0x1c
++#define ZX279133_GPIO_IRQ_MASK		0x28
++#define ZX279133_GPIO_IRQ_ENABLE	0x2c
++#define ZX279133_GPIO_IRQ_PENDING	0x30
++#define ZX279133_GPIO_IRQ_ACK		0x34
++
++#define ZX279133_GPIO_LINES		16
++
++struct zx279133_gpio {
++	struct gpio_chip chip;
++	void __iomem *base;
++	raw_spinlock_t lock;
++};
++
++static int zx279133_gpio_get_direction(struct gpio_chip *chip,
++				       unsigned int offset)
++{
++	struct zx279133_gpio *gpio = gpiochip_get_data(chip);
++
++	return readw(gpio->base + ZX279133_GPIO_DIR) & BIT(offset) ?
++		GPIO_LINE_DIRECTION_OUT : GPIO_LINE_DIRECTION_IN;
++}
++
++static int zx279133_gpio_direction_input(struct gpio_chip *chip,
++					 unsigned int offset)
++{
++	struct zx279133_gpio *gpio = gpiochip_get_data(chip);
++	unsigned long flags;
++	u16 direction;
++
++	raw_spin_lock_irqsave(&gpio->lock, flags);
++	direction = readw(gpio->base + ZX279133_GPIO_DIR);
++	writew(direction & ~BIT(offset), gpio->base + ZX279133_GPIO_DIR);
++	raw_spin_unlock_irqrestore(&gpio->lock, flags);
++
++	return 0;
++}
++
++static int zx279133_gpio_get(struct gpio_chip *chip, unsigned int offset)
++{
++	struct zx279133_gpio *gpio = gpiochip_get_data(chip);
++
++	return !!(readw(gpio->base + ZX279133_GPIO_DATA) & BIT(offset));
++}
++
++static int zx279133_gpio_set(struct gpio_chip *chip, unsigned int offset,
++			     int value)
++{
++	struct zx279133_gpio *gpio = gpiochip_get_data(chip);
++
++	writew(BIT(offset), gpio->base +
++	       (value ? ZX279133_GPIO_SET : ZX279133_GPIO_CLEAR));
++
++	return 0;
++}
++
++static int zx279133_gpio_direction_output(struct gpio_chip *chip,
++					  unsigned int offset, int value)
++{
++	struct zx279133_gpio *gpio = gpiochip_get_data(chip);
++	unsigned long flags;
++	u16 direction;
++
++	/* Latch the requested level before enabling the output driver. */
++	zx279133_gpio_set(chip, offset, value);
++
++	raw_spin_lock_irqsave(&gpio->lock, flags);
++	direction = readw(gpio->base + ZX279133_GPIO_DIR);
++	writew(direction | BIT(offset), gpio->base + ZX279133_GPIO_DIR);
++	raw_spin_unlock_irqrestore(&gpio->lock, flags);
++
++	return 0;
++}
++
++static void zx279133_gpio_irq_ack(struct irq_data *data)
++{
++	struct gpio_chip *chip = irq_data_get_irq_chip_data(data);
++	struct zx279133_gpio *gpio = gpiochip_get_data(chip);
++
++	writew(BIT(irqd_to_hwirq(data)), gpio->base + ZX279133_GPIO_IRQ_ACK);
++}
++
++static void zx279133_gpio_irq_mask(struct irq_data *data)
++{
++	struct gpio_chip *chip = irq_data_get_irq_chip_data(data);
++	struct zx279133_gpio *gpio = gpiochip_get_data(chip);
++	unsigned int offset = irqd_to_hwirq(data);
++	unsigned long flags;
++	u16 enable, mask;
++
++	raw_spin_lock_irqsave(&gpio->lock, flags);
++	mask = readw(gpio->base + ZX279133_GPIO_IRQ_MASK);
++	writew(mask | BIT(offset), gpio->base + ZX279133_GPIO_IRQ_MASK);
++	enable = readw(gpio->base + ZX279133_GPIO_IRQ_ENABLE);
++	writew(enable & ~BIT(offset), gpio->base + ZX279133_GPIO_IRQ_ENABLE);
++	raw_spin_unlock_irqrestore(&gpio->lock, flags);
++
++	gpiochip_disable_irq(chip, offset);
++}
++
++static void zx279133_gpio_irq_unmask(struct irq_data *data)
++{
++	struct gpio_chip *chip = irq_data_get_irq_chip_data(data);
++	struct zx279133_gpio *gpio = gpiochip_get_data(chip);
++	unsigned int offset = irqd_to_hwirq(data);
++	unsigned long flags;
++	u16 enable, mask;
++
++	gpiochip_enable_irq(chip, offset);
++
++	raw_spin_lock_irqsave(&gpio->lock, flags);
++	enable = readw(gpio->base + ZX279133_GPIO_IRQ_ENABLE);
++	writew(enable | BIT(offset), gpio->base + ZX279133_GPIO_IRQ_ENABLE);
++	mask = readw(gpio->base + ZX279133_GPIO_IRQ_MASK);
++	writew(mask & ~BIT(offset), gpio->base + ZX279133_GPIO_IRQ_MASK);
++	raw_spin_unlock_irqrestore(&gpio->lock, flags);
++}
++
++static int zx279133_gpio_irq_set_type(struct irq_data *data,
++				      unsigned int flow_type)
++{
++	struct gpio_chip *chip = irq_data_get_irq_chip_data(data);
++	struct zx279133_gpio *gpio = gpiochip_get_data(chip);
++	unsigned int offset = irqd_to_hwirq(data);
++	unsigned long flags;
++	u16 bit = BIT(offset);
++	u16 falling, level, mode, rising;
++
++	flow_type &= IRQ_TYPE_SENSE_MASK;
++
++	raw_spin_lock_irqsave(&gpio->lock, flags);
++	mode = readw(gpio->base + ZX279133_GPIO_IRQ_MODE);
++	level = readw(gpio->base + ZX279133_GPIO_IRQ_LEVEL);
++	rising = readw(gpio->base + ZX279133_GPIO_IRQ_RISING);
++	falling = readw(gpio->base + ZX279133_GPIO_IRQ_FALLING);
++
++	switch (flow_type) {
++	case IRQ_TYPE_EDGE_RISING:
++		mode &= ~bit;
++		rising |= bit;
++		falling &= ~bit;
++		irq_set_handler_locked(data, handle_edge_irq);
++		break;
++	case IRQ_TYPE_EDGE_FALLING:
++		mode &= ~bit;
++		rising &= ~bit;
++		falling |= bit;
++		irq_set_handler_locked(data, handle_edge_irq);
++		break;
++	case IRQ_TYPE_EDGE_BOTH:
++		mode &= ~bit;
++		rising |= bit;
++		falling |= bit;
++		irq_set_handler_locked(data, handle_edge_irq);
++		break;
++	case IRQ_TYPE_LEVEL_HIGH:
++		mode |= bit;
++		level |= bit;
++		rising &= ~bit;
++		falling &= ~bit;
++		irq_set_handler_locked(data, handle_level_irq);
++		break;
++	case IRQ_TYPE_LEVEL_LOW:
++		mode |= bit;
++		level &= ~bit;
++		rising &= ~bit;
++		falling &= ~bit;
++		irq_set_handler_locked(data, handle_level_irq);
++		break;
++	default:
++		raw_spin_unlock_irqrestore(&gpio->lock, flags);
++		return -EINVAL;
++	}
++
++	/* Program polarity and edge selection before changing edge/level mode. */
++	writew(rising, gpio->base + ZX279133_GPIO_IRQ_RISING);
++	writew(falling, gpio->base + ZX279133_GPIO_IRQ_FALLING);
++	writew(level, gpio->base + ZX279133_GPIO_IRQ_LEVEL);
++	writew(mode, gpio->base + ZX279133_GPIO_IRQ_MODE);
++	raw_spin_unlock_irqrestore(&gpio->lock, flags);
++
++	return 0;
++}
++
++static const struct irq_chip zx279133_gpio_irq_chip = {
++	.name = "zx279133-gpio",
++	.irq_ack = zx279133_gpio_irq_ack,
++	.irq_mask = zx279133_gpio_irq_mask,
++	.irq_unmask = zx279133_gpio_irq_unmask,
++	.irq_set_type = zx279133_gpio_irq_set_type,
++	.flags = IRQCHIP_IMMUTABLE,
++	GPIOCHIP_IRQ_RESOURCE_HELPERS,
++};
++
++static void zx279133_gpio_irq_handler(struct irq_desc *desc)
++{
++	struct gpio_chip *chip = irq_desc_get_handler_data(desc);
++	struct zx279133_gpio *gpio = gpiochip_get_data(chip);
++	struct irq_chip *parent_chip = irq_desc_get_chip(desc);
++	unsigned long pending;
++	u16 enabled, mask;
++	unsigned int offset;
++
++	chained_irq_enter(parent_chip, desc);
++
++	pending = readw(gpio->base + ZX279133_GPIO_IRQ_PENDING);
++	enabled = readw(gpio->base + ZX279133_GPIO_IRQ_ENABLE);
++	mask = readw(gpio->base + ZX279133_GPIO_IRQ_MASK);
++	pending &= enabled & ~mask & GENMASK(chip->ngpio - 1, 0);
++
++	for_each_set_bit(offset, &pending, chip->ngpio)
++		generic_handle_domain_irq(chip->irq.domain, offset);
++
++	chained_irq_exit(parent_chip, desc);
++}
++
++static int zx279133_gpio_irq_init_hw(struct gpio_chip *chip)
++{
++	struct zx279133_gpio *gpio = gpiochip_get_data(chip);
++	unsigned long flags;
++
++	raw_spin_lock_irqsave(&gpio->lock, flags);
++	writew(0xffff, gpio->base + ZX279133_GPIO_IRQ_MASK);
++	writew(0, gpio->base + ZX279133_GPIO_IRQ_ENABLE);
++	writew(0xffff, gpio->base + ZX279133_GPIO_IRQ_ACK);
++	raw_spin_unlock_irqrestore(&gpio->lock, flags);
++
++	return 0;
++}
++
++static int zx279133_gpio_probe(struct platform_device *pdev)
++{
++	struct device *dev = &pdev->dev;
++	struct gpio_irq_chip *irq_chip;
++	struct zx279133_gpio *gpio;
++	u32 ngpios;
++	int irq, ret;
++
++	gpio = devm_kzalloc(dev, sizeof(*gpio), GFP_KERNEL);
++	if (!gpio)
++		return -ENOMEM;
++
++	gpio->base = devm_platform_ioremap_resource(pdev, 0);
++	if (IS_ERR(gpio->base))
++		return PTR_ERR(gpio->base);
++
++	if (device_property_read_u32(dev, "ngpios", &ngpios) || !ngpios || ngpios > ZX279133_GPIO_LINES)
++		ngpios = ZX279133_GPIO_LINES;
++
++	raw_spin_lock_init(&gpio->lock);
++	gpio->chip.label = dev_name(dev);
++	gpio->chip.parent = dev;
++	gpio->chip.owner = THIS_MODULE;
++	gpio->chip.base = -1;
++	gpio->chip.ngpio = ngpios;
++	gpio->chip.request = gpiochip_generic_request;
++	gpio->chip.free = gpiochip_generic_free;
++	gpio->chip.get_direction = zx279133_gpio_get_direction;
++	gpio->chip.direction_input = zx279133_gpio_direction_input;
++	gpio->chip.direction_output = zx279133_gpio_direction_output;
++	gpio->chip.get = zx279133_gpio_get;
++	gpio->chip.set = zx279133_gpio_set;
++
++	irq = platform_get_irq_optional(pdev, 0);
++	if (irq > 0) {
++		irq_chip = &gpio->chip.irq;
++		gpio_irq_chip_set_chip(irq_chip, &zx279133_gpio_irq_chip);
++		irq_chip->default_type = IRQ_TYPE_NONE;
++		irq_chip->handler = handle_bad_irq;
++		irq_chip->parent_handler = zx279133_gpio_irq_handler;
++		irq_chip->num_parents = 1;
++		irq_chip->parents = devm_kcalloc(dev, 1, sizeof(*irq_chip->parents), GFP_KERNEL);
++		if (!irq_chip->parents)
++			return -ENOMEM;
++		irq_chip->parents[0] = irq;
++		irq_chip->init_hw = zx279133_gpio_irq_init_hw;
++	}
++
++	ret = devm_gpiochip_add_data(dev, &gpio->chip, gpio);
++	if (ret)
++		return dev_err_probe(dev, ret, "failed to register gpiochip\n");
++
++	dev_info(dev, "registered %u GPIO lines\n", ngpios);
++
++	return 0;
++}
++
++static const struct of_device_id zx279133_gpio_of_match[] = {
++	{ .compatible = "zte,zx279128s-gpio" },
++	{ .compatible = "zte,zx279133-gpio" },
++	{ }
++};
++MODULE_DEVICE_TABLE(of, zx279133_gpio_of_match);
++
++static struct platform_driver zx279133_gpio_driver = {
++	.probe = zx279133_gpio_probe,
++	.driver = {
++		.name = "zx279133-gpio",
++		.of_match_table = zx279133_gpio_of_match,
++	},
++};
++module_platform_driver(zx279133_gpio_driver);
++
++MODULE_DESCRIPTION("ZTE ZX279133 GPIO controller driver");
++MODULE_LICENSE("GPL");
diff --git a/target/linux/sanechips/patches-6.18/004-zte-zx-smp.patch b/target/linux/sanechips/patches-6.18/004-zte-zx-smp.patch
new file mode 100644
index 0000000000..ebc8804206
--- /dev/null
+++ b/target/linux/sanechips/patches-6.18/004-zte-zx-smp.patch
@@ -0,0 +1,158 @@
+From: Navid Ghahremani <ghahramani.navid@gmail.com>
+Subject: [PATCH] soc: zte: add ZX279128S SMP bring-up
+
+The bootloader parks the second Cortex-A9 in WFE and sends it to IRAM
+address 0x200800 on SEV.  Write a trampoline to secondary_startup there,
+enable the SCU and wake the core.
+
+Signed-off-by: Navid Ghahremani <ghahramani.navid@gmail.com>
+---
+--- a/arch/arm/Kconfig.platforms
++++ b/arch/arm/Kconfig.platforms
+@@ -64,6 +64,7 @@ config ARCH_VIRT
+ 	select ARM_GIC_V2M if PCI
+ 	select ARM_GIC_V3
+ 	select ARM_GIC_V3_ITS if PCI
++	select HAVE_ARM_SCU
+ 	select ARM_PSCI
+ 	select HAVE_ARM_ARCH_TIMER
+ 	select ARM_GLOBAL_TIMER
+--- a/drivers/soc/Kconfig
++++ b/drivers/soc/Kconfig
+@@ -31,5 +31,6 @@ source "drivers/soc/ux500/Kconfig"
+ source "drivers/soc/versatile/Kconfig"
+ source "drivers/soc/vt8500/Kconfig"
+ source "drivers/soc/xilinx/Kconfig"
++source "drivers/soc/zte/Kconfig"
+ 
+ endmenu
+--- a/drivers/soc/Makefile
++++ b/drivers/soc/Makefile
+@@ -37,3 +37,4 @@ obj-$(CONFIG_ARCH_U8500)	+= ux500/
+ obj-y				+= versatile/
+ obj-y				+= vt8500/
+ obj-y				+= xilinx/
++obj-y				+= zte/
+--- /dev/null
++++ b/drivers/soc/zte/Kconfig
+@@ -0,0 +1,12 @@
++# SPDX-License-Identifier: GPL-2.0-only
++
++config ZX279128S_SMP
++	bool "ZTE ZX279128S SMP support"
++	depends on SMP && OF
++	select HAVE_ARM_SCU
++	default y
++	help
++	  Enables SMP boot support for the ZTE/Sanechips ZX279128S SoC
++	  (dual Cortex-A9). The secondary CPU is brought up by writing a
++	  trampoline to IRAM at 0x200800 and issuing a SEV to wake the
++	  WFE-parked core.
+--- /dev/null
++++ b/drivers/soc/zte/Makefile
+@@ -0,0 +1,2 @@
++# SPDX-License-Identifier: GPL-2.0-only
++obj-$(CONFIG_ZX279128S_SMP)	+= platsmp-zx279128.o
+--- /dev/null
++++ b/drivers/soc/zte/platsmp-zx279128.c
+@@ -0,0 +1,100 @@
++// SPDX-License-Identifier: GPL-2.0-only
++/*
++ * ZTE ZX279128S SMP boot support
++ *
++ * The secondary Cortex-A9 core is parked in WFE by U-Boot and jumps
++ * to IRAM 0x200800 when woken by SEV. The kernel writes a two-word
++ * trampoline there:
++ *   [0] = 0xe51ff004   (ldr pc, [pc, #-4])
++ *   [4] = __pa_symbol(secondary_startup)
++ *
++ * The SCU must be enabled before booting the secondary core.
++ */
++
++#include <linux/io.h>
++#include <linux/of.h>
++#include <linux/of_address.h>
++#include <linux/smp.h>
++
++#include <asm/cacheflush.h>
++#include <asm/smp_plat.h>
++#include <asm/smp_scu.h>
++#include <asm/smp.h>
++
++static void __iomem *scu_base;
++static void __iomem *iram_base;
++
++#define ZX_TRAMPOLINE_INST	0xe51ff004	/* ldr pc, [pc, #-4] */
++
++static int zx279128_boot_secondary(unsigned int cpu, struct task_struct *idle)
++{
++	if (!iram_base)
++		return -ENODEV;
++
++	/*
++	 * Write trampoline to IRAM:
++	 *   [0] = ldr pc, [pc, #-4]   -> loads word at [4]
++	 *   [4] = physical address of secondary_startup
++	 */
++	writel(ZX_TRAMPOLINE_INST, iram_base);
++	writel(__pa_symbol(secondary_startup), iram_base + 4);
++
++	/* Ensure the trampoline is visible to the secondary core */
++	flush_cache_all();
++	outer_clean_range(__pa(iram_base), __pa(iram_base) + 8);
++	smp_wmb();
++
++	/* Wake the secondary core from WFE */
++	dsb_sev();
++
++	return 0;
++}
++
++static void __init zx279128_smp_prepare_cpus(unsigned int max_cpus)
++{
++	struct device_node *np;
++
++	/* Map SCU from device tree */
++	np = of_find_compatible_node(NULL, NULL, "arm,cortex-a9-scu");
++	if (np) {
++		scu_base = of_iomap(np, 0);
++		of_node_put(np);
++	} else {
++		/* Fallback: read periphbase from CP15 */
++		unsigned long base;
++
++		asm("mrc p15, 4, %0, c15, c0, 0" : "=r" (base));
++		scu_base = ioremap(base, SZ_256);
++	}
++
++	if (!scu_base) {
++		pr_err("%s: failed to map SCU\n", __func__);
++		return;
++	}
++
++	/* Map IRAM (boot vector for secondary CPU) */
++	np = of_find_compatible_node(NULL, NULL, "zte,iram");
++	if (!np) {
++		pr_err("%s: failed to find iram node\n", __func__);
++		iounmap(scu_base);
++		scu_base = NULL;
++		return;
++	}
++
++	iram_base = of_iomap(np, 0);
++	of_node_put(np);
++	if (!iram_base) {
++		pr_err("%s: failed to map iram\n", __func__);
++		iounmap(scu_base);
++		scu_base = NULL;
++		return;
++	}
++
++	scu_enable(scu_base);
++}
++
++static const struct smp_operations zx279128_smp_ops __initconst = {
++	.smp_prepare_cpus	= zx279128_smp_prepare_cpus,
++	.smp_boot_secondary	= zx279128_boot_secondary,
++};
++CPU_METHOD_OF_DECLARE(zx279128_smp, "zte,zx279128-smp", &zx279128_smp_ops);
diff --git a/target/linux/sanechips/patches-6.18/005-zte-zx-pcie.patch b/target/linux/sanechips/patches-6.18/005-zte-zx-pcie.patch
new file mode 100644
index 0000000000..5a7bcffafe
--- /dev/null
+++ b/target/linux/sanechips/patches-6.18/005-zte-zx-pcie.patch
@@ -0,0 +1,340 @@
+From: Navid Ghahremani <ghahramani.navid@gmail.com>
+Subject: [PATCH] PCI: dwc: add the ZTE ZX279128S PCIe host controller
+
+Add a DesignWare based host driver for the two PCIe ports of the
+ZX279128S, which connect the MT7915 Wi-Fi on the ZTE ZXHN H3600.
+
+Signed-off-by: Navid Ghahremani <ghahramani.navid@gmail.com>
+---
+--- a/drivers/pci/controller/dwc/Kconfig
++++ b/drivers/pci/controller/dwc/Kconfig
+@@ -518,4 +518,14 @@ config PCIE_VISCONTI_HOST
+ 	  Say Y here if you want PCIe controller support on Toshiba Visconti SoC.
+ 	  This driver supports TMPV7708 SoC.
+ 
++config PCIE_ZX279128
++	bool "ZTE ZX279128S PCIe controller"
++	depends on OF
++	select PCIE_DW_HOST
++	default y
++	help
++	  Say Y here to enable PCIe support for ZTE/Sanechips ZX279128S SoC.
++	  This driver supports the DesignWare-based PCIe host controller with
++	  ZTE-specific PHY and link initialization.
++
+ endmenu
+--- a/drivers/pci/controller/dwc/Makefile
++++ b/drivers/pci/controller/dwc/Makefile
+@@ -33,6 +33,7 @@ obj-$(CONFIG_PCIE_VISCONTI_HOST) += pcie
+ obj-$(CONFIG_PCIE_RCAR_GEN4) += pcie-rcar-gen4.o
+ obj-$(CONFIG_PCIE_STM32_HOST) += pcie-stm32.o
+ obj-$(CONFIG_PCIE_STM32_EP) += pcie-stm32-ep.o
++obj-$(CONFIG_PCIE_ZX279128) += pcie-zx279128.o
+ 
+ # The following drivers are for devices that use the generic ACPI
+ # pci_root.c driver but don't support standard ECAM config access.
+--- /dev/null
++++ b/drivers/pci/controller/dwc/pcie-zx279128.c
+@@ -0,0 +1,302 @@
++// SPDX-License-Identifier: GPL-2.0
++/*
++ * ZTE ZX279128S PCIe Host Controller Driver
++ *
++ * Copyright (C) 2026 OpenWrt.org
++ */
++
++#include <linux/delay.h>
++#include <linux/gpio/consumer.h>
++#include <linux/init.h>
++#include <linux/interrupt.h>
++#include <linux/io.h>
++#include <linux/kernel.h>
++#include <linux/module.h>
++#include <linux/of.h>
++#include <linux/pci.h>
++#include <linux/platform_device.h>
++#include <linux/resource.h>
++
++#include "pcie-designware.h"
++
++struct zx_pcie {
++	struct dw_pcie		pci;
++	void __iomem		*topcrm1;	/* 0x94000000: Top CRM 1 (PLL / PHY ctrl) */
++	void __iomem		*topcrm2;	/* 0x94100000: Top CRM 2 (clocks & resets) */
++	void __iomem		*topcrm3;	/* 0x94200000: Top CRM 3 (GPIO CRM) */
++	void __iomem		*ctrl_base;	/* 0x09500000 (P0) or 0x09600000 (P1) */
++	struct gpio_desc	*reset_gpio;
++	struct gpio_desc	*enable_gpio;
++	int			port_id;
++};
++
++#define to_zx_pcie(x)	dev_get_drvdata((x)->dev)
++
++static bool zx_board_reset_done;
++
++static void zx279128_pcie_init_hw(struct zx_pcie *pcie)
++{
++	struct dw_pcie *pci = &pcie->pci;
++	struct device *dev = pci->dev;
++
++	if (!zx_board_reset_done) {
++		zx_board_reset_done = true;
++		dev_info(dev, "asserting MT7915 board reset (GPIO 53 and 55 LOW = 0V)\n");
++		if (pcie->reset_gpio)
++			gpiod_direction_output_raw(pcie->reset_gpio, 0);
++		if (pcie->enable_gpio)
++			gpiod_direction_output_raw(pcie->enable_gpio, 0);
++		msleep(100);
++
++		dev_info(dev, "releasing MT7915 board reset (GPIO 53 and 55 HIGH = 3.3V)\n");
++		if (pcie->reset_gpio)
++			gpiod_set_raw_value_cansleep(pcie->reset_gpio, 1);
++		if (pcie->enable_gpio)
++			gpiod_set_raw_value_cansleep(pcie->enable_gpio, 1);
++		msleep(200);
++	}
++
++	dev_info(dev, "pcie%d: configuring CRM registers\n", pcie->port_id);
++
++	if (pcie->port_id == 0) {
++		/* Port 0 setting sequence from ZTE firmware */
++		/* 1. Top CRM 2 (0x94100000): ungate PCIe 0 clock */
++		writel(readl(pcie->topcrm2 + 0x70) | 0xb5, pcie->topcrm2 + 0x70);
++		udelay(50);
++
++		/* 2. Top CRM 1 (0x94000000): PCIe 0 PHY/PLL configuration */
++		writel(readl(pcie->topcrm1 + 0x08) | 0x8000, pcie->topcrm1 + 0x08);
++		udelay(50);
++		writel(readl(pcie->topcrm1 + 0x08) | 0x2000, pcie->topcrm1 + 0x08);
++		udelay(50);
++		writel(readl(pcie->topcrm1 + 0x08) | 0x4000, pcie->topcrm1 + 0x08);
++		udelay(50);
++
++		/* 3. Top CRM 2 (0x94100000): release PCIe 0 reset bit 0 */
++		writel(readl(pcie->topcrm2 + 0x74) & ~1, pcie->topcrm2 + 0x74);
++		udelay(50);
++
++		/* 4. Top CRM 3 (0x94200000): GPIO CRM */
++		if (pcie->topcrm3)
++			writel(readl(pcie->topcrm3 + 0x0c) & ~0x4000, pcie->topcrm3 + 0x0c);
++		udelay(500);
++
++		/* 5. Top CRM 1 (0x94000000): bit 26 clear */
++		writel(readl(pcie->topcrm1 + 0x24) & ~0x4000000, pcie->topcrm1 + 0x24);
++		udelay(50);
++
++		/* 6. Top CRM 2 (0x94100000): deassert resets */
++		writel(readl(pcie->topcrm2 + 0x74) | 1, pcie->topcrm2 + 0x74);
++		writel(readl(pcie->topcrm2 + 0x70) & ~0x100, pcie->topcrm2 + 0x70);
++		writel(0x3f, pcie->topcrm2 + 0x74);
++
++		/* 7. Controller wrapper (0x09500000): enable bit 0x20 */
++		writel(readl(pcie->ctrl_base + 0x00) | 0x20, pcie->ctrl_base + 0x00);
++	} else {
++		/* Port 1 setting sequence from ZTE firmware */
++		/* 1. Top CRM 2 (0x94100000): ungate PCIe 1 clock */
++		writel(readl(pcie->topcrm2 + 0x70) | 0x1aa00, pcie->topcrm2 + 0x70);
++		udelay(50);
++
++		/* 2. Top CRM 1 (0x94000000): PCIe 1 PHY/PLL configuration & calibration */
++		writel(readl(pcie->topcrm1 + 0x08) | 0x8000000, pcie->topcrm1 + 0x08);
++		udelay(50);
++		writel(0x00202d5a, pcie->topcrm1 + 0x1b4);
++		writel(0x0046c24a, pcie->topcrm1 + 0x1b0);
++		writel(readl(pcie->topcrm1 + 0x08) | 0x2000000, pcie->topcrm1 + 0x08);
++		udelay(50);
++		writel(readl(pcie->topcrm1 + 0x08) | 0x4000000, pcie->topcrm1 + 0x08);
++		udelay(50);
++
++		/* 3. Top CRM 2 (0x94100000): release PCIe 1 reset bit 3 */
++		writel(readl(pcie->topcrm2 + 0x74) & ~8, pcie->topcrm2 + 0x74);
++		udelay(50);
++
++		/* 4. Top CRM 3 (0x94200000): GPIO CRM */
++		if (pcie->topcrm3)
++			writel(readl(pcie->topcrm3 + 0x0c) & ~0x0002, pcie->topcrm3 + 0x0c);
++		udelay(50);
++
++		/* 5. Top CRM 1 (0x94000000): bit 26 clear */
++		writel(readl(pcie->topcrm1 + 0x24) & ~0x4000000, pcie->topcrm1 + 0x24);
++		udelay(50);
++
++		/* 6. Top CRM 2 (0x94100000): deassert resets */
++		writel(readl(pcie->topcrm2 + 0x74) | 8, pcie->topcrm2 + 0x74);
++		writel(readl(pcie->topcrm2 + 0x70) & ~0x20000, pcie->topcrm2 + 0x70);
++		writel(0x3f, pcie->topcrm2 + 0x74);
++
++		/* 7. Controller wrapper (0x09600000): enable bit 0x20 */
++		writel(readl(pcie->ctrl_base + 0x00) | 0x20, pcie->ctrl_base + 0x00);
++	}
++
++	/* 8. Link capabilities: set max link width = 1 & retrain */
++	writel((readl(pcie->pci.dbi_base + 0xa0) & ~0xf) | 1, pcie->pci.dbi_base + 0xa0);
++	writel(readl(pcie->pci.dbi_base + 0x80) | 0x20, pcie->pci.dbi_base + 0x80);
++
++	dev_info(dev, "pcie%d: CRM initialized successfully\n", pcie->port_id);
++}
++
++static int zx_pcie_start_link(struct dw_pcie *pci)
++{
++	struct zx_pcie *pcie = to_zx_pcie(pci);
++	u32 val;
++	int retries = 2000;
++
++	/* Configure target link width = 1 and trigger link retrain */
++	dw_pcie_dbi_ro_wr_en(pci);
++	writel((readl(pci->dbi_base + 0xa0) & ~0xf) | 1, pci->dbi_base + 0xa0);
++	writel(readl(pci->dbi_base + 0x80) | 0x20, pci->dbi_base + 0x80);
++	dw_pcie_dbi_ro_wr_dis(pci);
++
++	while (retries--) {
++		val = readl(pcie->ctrl_base + 0xdc);
++		if (((val >> 17) & 0x3f) == 0x11) {
++			u32 link_stat = readl(pci->dbi_base + 0x80);
++			u32 speed = (link_stat >> 16) & 0xf;
++			dev_info(pci->dev, "pcie%d link up, gen%u (LTSSM L0, stat 0x%08x)\n",
++				 pcie->port_id, speed ? 2 : 1, val);
++			return 0;
++		}
++		udelay(100);
++	}
++
++	val = readl(pcie->ctrl_base + 0xdc);
++	dev_warn(pci->dev, "pcie%d link timeout (LTSSM: 0x%02x, ctrl 0xdc: 0x%08x)\n",
++		 pcie->port_id, (val >> 17) & 0x3f, val);
++	return 0;
++}
++
++static bool zx_pcie_link_up(struct dw_pcie *pci)
++{
++	struct zx_pcie *pcie = to_zx_pcie(pci);
++	u32 val = readl(pcie->ctrl_base + 0xdc);
++
++	return ((val >> 17) & 0x3f) == 0x11;
++}
++
++static const struct dw_pcie_ops zx_dw_pcie_ops = {
++	.link_up	= zx_pcie_link_up,
++	.start_link	= zx_pcie_start_link,
++};
++
++static int zx_pcie_host_init(struct dw_pcie_rp *pp)
++{
++	return 0;
++}
++
++static int zx_pcie_msi_init(struct dw_pcie_rp *pp)
++{
++	/* ZTE ZX279128 uses legacy INTx via GIC SPI interrupts */
++	return 0;
++}
++
++static const struct dw_pcie_host_ops zx_pcie_host_ops = {
++	.init = zx_pcie_host_init,
++	.msi_init = zx_pcie_msi_init,
++};
++
++static int zx_pcie_probe(struct platform_device *pdev)
++{
++	struct device *dev = &pdev->dev;
++	struct zx_pcie *pcie;
++	struct dw_pcie *pci;
++	struct resource *res;
++	int ret;
++
++	pcie = devm_kzalloc(dev, sizeof(*pcie), GFP_KERNEL);
++	if (!pcie)
++		return -ENOMEM;
++
++	pci = &pcie->pci;
++	pci->dev = dev;
++	pci->ops = &zx_dw_pcie_ops;
++	pci->pp.ops = &zx_pcie_host_ops;
++
++	/* Determine port ID (0 or 1) */
++	if (of_property_read_u32(dev->of_node, "port-id", &pcie->port_id))
++		pcie->port_id = 0;
++
++	dev_info(dev, "Probing ZTE ZX279128S PCIe port %d...\n", pcie->port_id);
++
++	/* Map DBI registers */
++	res = platform_get_resource_byname(pdev, IORESOURCE_MEM, "dbi");
++	if (!res) {
++		dev_err(dev, "Missing dbi resource\n");
++		return -EINVAL;
++	}
++	pci->dbi_base = devm_pci_remap_cfg_resource(dev, res);
++	if (IS_ERR(pci->dbi_base))
++		return PTR_ERR(pci->dbi_base);
++	pci->dbi_phys_addr = res->start;
++
++	/* Map Controller registers */
++	res = platform_get_resource_byname(pdev, IORESOURCE_MEM, "ctrl");
++	if (!res) {
++		dev_err(dev, "Missing ctrl resource\n");
++		return -EINVAL;
++	}
++	pcie->ctrl_base = devm_ioremap_resource(dev, res);
++	if (IS_ERR(pcie->ctrl_base))
++		return PTR_ERR(pcie->ctrl_base);
++
++	/* Map Top CRM 1 (0x94000000: PLL & PHY ctrl) */
++	pcie->topcrm1 = devm_ioremap(dev, 0x94000000, 0x1000);
++	if (!pcie->topcrm1) {
++		dev_err(dev, "Failed to map Top CRM 1\n");
++		return -ENOMEM;
++	}
++
++	/* Map Top CRM 2 (0x94100000: Clocks & Resets) */
++	pcie->topcrm2 = devm_ioremap(dev, 0x94100000, 0x1000);
++	if (!pcie->topcrm2) {
++		dev_err(dev, "Failed to map Top CRM 2\n");
++		return -ENOMEM;
++	}
++
++	/* Map Top CRM 3 (0x94200000: GPIO CRM) */
++	pcie->topcrm3 = devm_ioremap(dev, 0x94200000, 0x1000);
++
++	/* Reset and enable GPIOs */
++	pcie->reset_gpio = devm_gpiod_get_optional(dev, "reset", GPIOD_ASIS);
++	if (IS_ERR(pcie->reset_gpio))
++		return dev_err_probe(dev, PTR_ERR(pcie->reset_gpio), "Failed to get reset GPIO\n");
++
++	pcie->enable_gpio = devm_gpiod_get_optional(dev, "enable", GPIOD_ASIS);
++	if (IS_ERR(pcie->enable_gpio))
++		return dev_err_probe(dev, PTR_ERR(pcie->enable_gpio), "Failed to get enable GPIO\n");
++
++	platform_set_drvdata(pdev, pcie);
++
++	/* Initialize hardware clocks, resets, and wrapper BEFORE DWC host init */
++	zx279128_pcie_init_hw(pcie);
++
++	ret = dw_pcie_host_init(&pci->pp);
++	if (ret) {
++		dev_err(dev, "dw_pcie_host_init failed: %d\n", ret);
++		return ret;
++	}
++
++	dev_info(dev, "ZTE ZX279128S PCIe port %d probed successfully\n", pcie->port_id);
++	return 0;
++}
++
++static const struct of_device_id zx_pcie_of_match[] = {
++	{ .compatible = "zte,zx279128s-pcie" },
++	{ .compatible = "zte,ZX279127-pcie" },
++	{},
++};
++MODULE_DEVICE_TABLE(of, zx_pcie_of_match);
++
++static struct platform_driver zx_pcie_driver = {
++	.driver = {
++		.name	= "zx279128-pcie",
++		.of_match_table = zx_pcie_of_match,
++		.suppress_bind_attrs = true,
++	},
++	.probe = zx_pcie_probe,
++};
++builtin_platform_driver(zx_pcie_driver);
++
++MODULE_DESCRIPTION("ZTE ZX279128S PCIe Host Controller Driver");
++MODULE_LICENSE("GPL");
diff --git a/target/linux/sanechips/patches-6.18/006-zte-zx-mdio.patch b/target/linux/sanechips/patches-6.18/006-zte-zx-mdio.patch
new file mode 100644
index 0000000000..38477ec87f
--- /dev/null
+++ b/target/linux/sanechips/patches-6.18/006-zte-zx-mdio.patch
@@ -0,0 +1,257 @@
+From: Navid Ghahremani <ghahramani.navid@gmail.com>
+Subject: [PATCH] net: mdio: add the ZTE ZX279128S MDIO controller
+
+Add a driver for the MDIO bus of the ZX279128S that reaches the PHYs
+of its integrated switch.
+
+Signed-off-by: Navid Ghahremani <ghahramani.navid@gmail.com>
+---
+--- a/drivers/net/mdio/Kconfig
++++ b/drivers/net/mdio/Kconfig
+@@ -44,6 +44,14 @@ config MDIO_XGENE
+ 	  This module provides a driver for the MDIO busses found in the
+ 	  APM X-Gene SoC's.
+ 
++config MDIO_ZX279128
++	tristate "ZTE ZX279128S MDIO bus controller"
++	depends on HAS_IOMEM && OF_MDIO
++	default y
++	help
++	  This module provides a driver for the MDIO bus controller found in the
++	  ZTE / Sanechips ZX279128S SoC.
++
+ config MDIO_ASPEED
+ 	tristate "ASPEED MDIO bus controller"
+ 	depends on ARCH_ASPEED || COMPILE_TEST
+--- a/drivers/net/mdio/Makefile
++++ b/drivers/net/mdio/Makefile
+@@ -34,3 +34,4 @@ obj-$(CONFIG_MDIO_BUS_MUX_MESON_G12A)	+=
+ obj-$(CONFIG_MDIO_BUS_MUX_MESON_GXL)	+= mdio-mux-meson-gxl.o
+ obj-$(CONFIG_MDIO_BUS_MUX_MMIOREG) 	+= mdio-mux-mmioreg.o
+ obj-$(CONFIG_MDIO_BUS_MUX_MULTIPLEXER) 	+= mdio-mux-multiplexer.o
++obj-$(CONFIG_MDIO_ZX279128)		+= mdio-zx279128.o
+--- /dev/null
++++ b/drivers/net/mdio/mdio-zx279128.c
+@@ -0,0 +1,222 @@
++// SPDX-License-Identifier: GPL-2.0-only
++/*
++ * MDIO bus driver for ZTE / Sanechips ZX279128S SoC
++ *
++ * Copyright (C) 2026 Navid & Antigravity
++ */
++
++#include <linux/clk.h>
++#include <linux/delay.h>
++#include <linux/io.h>
++#include <linux/iopoll.h>
++#include <linux/module.h>
++#include <linux/of_mdio.h>
++#include <linux/platform_device.h>
++
++#define ZX_MDIO_DATA_WR		0x04
++#define ZX_MDIO_DATA_RD		0x08
++#define ZX_MDIO_CFG		0x0c
++#define ZX_MDIO_STATUS		0x10
++#define  ZX_MDIO_DONE		BIT(0)
++#define ZX_MDIO_CMD		0x14
++#define  ZX_MDIO_CMD_REG_MASK	GENMASK(4, 0)
++#define  ZX_MDIO_CMD_ADDR_SHIFT	5
++#define  ZX_MDIO_CMD_ADDR_MASK	GENMASK(9, 5)
++#define  ZX_MDIO_CMD_WR		BIT(10)
++#define  ZX_MDIO_CMD_RD		BIT(11)
++#define  ZX_MDIO_CMD_CLK_DIV	BIT(12)
++#define  ZX_MDIO_CMD_START	BIT(14)
++
++struct zx_mdio_priv {
++	void __iomem *base;
++	struct clk *clk;
++};
++
++static int zx_mdio_wait_done(void __iomem *base)
++{
++	u32 val;
++	int ret;
++
++	ret = readl_poll_timeout_atomic(base + ZX_MDIO_STATUS, val,
++					(val & ZX_MDIO_DONE), 1, 2000);
++	if (ret)
++		return ret;
++
++	writel(0, base + ZX_MDIO_STATUS);
++	writel(readl(base + ZX_MDIO_CMD) & ~ZX_MDIO_CMD_START, base + ZX_MDIO_CMD);
++	return 0;
++}
++
++static int zx_mdio_read(struct mii_bus *bus, int addr, int regnum)
++{
++	struct zx_mdio_priv *priv = bus->priv;
++	void __iomem *base = priv->base;
++	u32 cmd;
++	int ret;
++
++	/* Clear any pending status */
++	writel(readl(base + ZX_MDIO_CMD) & ~ZX_MDIO_CMD_START, base + ZX_MDIO_CMD);
++	writel(0, base + ZX_MDIO_STATUS);
++
++	cmd = readl(base + ZX_MDIO_CMD);
++	cmd &= ~(ZX_MDIO_CMD_WR | ZX_MDIO_CMD_RD | ZX_MDIO_CMD_ADDR_MASK | ZX_MDIO_CMD_REG_MASK);
++	cmd |= ZX_MDIO_CMD_RD;
++	cmd |= ((addr & 0x1f) << ZX_MDIO_CMD_ADDR_SHIFT);
++	cmd |= (regnum & 0x1f);
++	cmd |= ZX_MDIO_CMD_START;
++
++	writel(cmd, base + ZX_MDIO_CMD);
++
++	ret = zx_mdio_wait_done(base);
++	if (ret) {
++		dev_err_ratelimited(&bus->dev, "MDIO read timeout (addr=%d, reg=%d)\n", addr, regnum);
++		return ret;
++	}
++
++	return readl(base + ZX_MDIO_DATA_RD) & 0xffff;
++}
++
++static int zx_mdio_write(struct mii_bus *bus, int addr, int regnum, u16 val)
++{
++	struct zx_mdio_priv *priv = bus->priv;
++	void __iomem *base = priv->base;
++	u32 cmd;
++	int ret;
++
++	writel(readl(base + ZX_MDIO_CMD) & ~ZX_MDIO_CMD_START, base + ZX_MDIO_CMD);
++	writel(0, base + ZX_MDIO_STATUS);
++
++	cmd = readl(base + ZX_MDIO_CMD);
++	cmd &= ~(ZX_MDIO_CMD_WR | ZX_MDIO_CMD_RD | ZX_MDIO_CMD_ADDR_MASK | ZX_MDIO_CMD_REG_MASK);
++	cmd |= ZX_MDIO_CMD_WR;
++	cmd |= ((addr & 0x1f) << ZX_MDIO_CMD_ADDR_SHIFT);
++	cmd |= (regnum & 0x1f);
++
++	writel(val, base + ZX_MDIO_DATA_WR);
++	writel(cmd | ZX_MDIO_CMD_START, base + ZX_MDIO_CMD);
++
++	ret = zx_mdio_wait_done(base);
++	if (ret) {
++		dev_err_ratelimited(&bus->dev, "MDIO write timeout (addr=%d, reg=%d)\n", addr, regnum);
++		return ret;
++	}
++
++	return 0;
++}
++
++static int zx_mdio_probe(struct platform_device *pdev)
++{
++	struct zx_mdio_priv *priv;
++	struct mii_bus *bus;
++	u32 val;
++	int ret;
++
++	bus = devm_mdiobus_alloc_size(&pdev->dev, sizeof(*priv));
++	if (!bus)
++		return -ENOMEM;
++
++	priv = bus->priv;
++	priv->base = devm_platform_ioremap_resource(pdev, 0);
++	if (IS_ERR(priv->base))
++		return PTR_ERR(priv->base);
++
++	priv->clk = devm_clk_get_optional_enabled(&pdev->dev, NULL);
++	if (IS_ERR(priv->clk))
++		return PTR_ERR(priv->clk);
++
++	/* Un-gate external ZX5201 PHY on WAN port via CRM register (0x9420000c) */
++	{
++		void __iomem *crm_reg = ioremap(0x9420000c, 4);
++		if (crm_reg) {
++			writel(readl(crm_reg) & ~(BIT(11) | BIT(19) | BIT(20)), crm_reg);
++			iounmap(crm_reg);
++			msleep(10);
++		}
++	}
++
++	/* Initialize hardware registers */
++	val = readl(priv->base + ZX_MDIO_CMD);
++	val &= ~(ZX_MDIO_CMD_START | BIT(15) | BIT(13));
++	val |= ZX_MDIO_CMD_CLK_DIV;
++	writel(val, priv->base + ZX_MDIO_CMD);
++	writel(0, priv->base + ZX_MDIO_STATUS);
++	writel(0, priv->base + ZX_MDIO_CFG);
++
++	bus->name = "zx-mdio";
++	bus->read = zx_mdio_read;
++	bus->write = zx_mdio_write;
++	snprintf(bus->id, MII_BUS_ID_SIZE, "%s", dev_name(&pdev->dev));
++	bus->parent = &pdev->dev;
++
++	/* Initialize ZX5201 PHY at MDIO 8/9 if present */
++	if ((zx_mdio_read(bus, 8, 2) & 0xffff) == 0x84b9) {
++		u16 v20, v21, v22;
++
++		dev_info(&pdev->dev, "Found Sanechips ZX5201 PHY at MDIO 8/9, initializing\n");
++		/* MDIO 8 (Copper PHY) */
++		zx_mdio_write(bus, 8, 18, 0x8402);
++		zx_mdio_write(bus, 9, 22, 0x0a0f);
++		zx_mdio_write(bus, 9, 27, 0x0800);
++		zx_mdio_write(bus, 8, 29, 0x0355);
++		zx_mdio_write(bus, 8, 16, 0xb62d);
++		zx_mdio_write(bus, 8, 17, 0x0006);
++
++		/* MDIO 9 (SerDes MAC interface) */
++		zx_mdio_write(bus, 9, 18, 0x0004);
++		v21 = zx_mdio_read(bus, 9, 21);
++		v20 = zx_mdio_read(bus, 9, 20);
++		zx_mdio_write(bus, 9, 17, (v21 & 0xc1ff) | 0x2800);
++		zx_mdio_write(bus, 9, 16, v20);
++		zx_mdio_write(bus, 9, 18, 0x0204);
++		v22 = zx_mdio_read(bus, 9, 22);
++		zx_mdio_write(bus, 9, 22, (v22 & 0xfff3) | 0x0004);
++
++		/* MDIO 8 LEDs */
++		zx_mdio_write(bus, 8, 16, 0xb409);
++		zx_mdio_write(bus, 8, 17, 0x0000);
++		zx_mdio_write(bus, 8, 16, 0xb407);
++		zx_mdio_write(bus, 8, 17, 0x0000);
++		zx_mdio_write(bus, 8, 16, 0xb406);
++		zx_mdio_write(bus, 8, 17, 0x0000);
++		zx_mdio_write(bus, 8, 16, 0xb408);
++		zx_mdio_write(bus, 8, 17, 0x0000);
++	}
++
++	ret = of_mdiobus_register(bus, pdev->dev.of_node);
++	if (ret) {
++		dev_err(&pdev->dev, "Failed to register MDIO bus: %d\n", ret);
++		return ret;
++	}
++
++	platform_set_drvdata(pdev, bus);
++	dev_info(&pdev->dev, "ZTE ZX279128S MDIO bus driver registered\n");
++	return 0;
++}
++
++static void zx_mdio_remove(struct platform_device *pdev)
++{
++	struct mii_bus *bus = platform_get_drvdata(pdev);
++
++	mdiobus_unregister(bus);
++}
++
++static const struct of_device_id zx_mdio_dt_ids[] = {
++	{ .compatible = "zte,zx279128s-mdio" },
++	{ .compatible = "zte,zx-mdio" },
++	{ /* sentinel */ }
++};
++MODULE_DEVICE_TABLE(of, zx_mdio_dt_ids);
++
++static struct platform_driver zx_mdio_driver = {
++	.probe = zx_mdio_probe,
++	.remove = zx_mdio_remove,
++	.driver = {
++		.name = "zx-mdio",
++		.of_match_table = zx_mdio_dt_ids,
++	},
++};
++module_platform_driver(zx_mdio_driver);
++
