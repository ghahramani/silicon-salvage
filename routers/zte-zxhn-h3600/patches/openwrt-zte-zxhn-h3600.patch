++	writel(members, base + ZX_SBRG_LEARN);
++	if (members) {
++		WRITE_ONCE(adapter->sw_members, members);
++		zx_update_traps(adapter);
++	}
++	dev_info(adapter->dev, "hardware LAN switching %s (bridge ports %#x)\n",
++		 members ? "on" : "off", members);
