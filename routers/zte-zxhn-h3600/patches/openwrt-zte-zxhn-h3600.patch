++	void __iomem *base = adapter->base;
++	u32 hi = mac[0] << 16 | mac[1] << 8 | mac[2];
++	u32 lo = mac[3] << 24 | mac[4] << 16 | mac[5] << 8;
++	int n = sizes[readl(base + ZX_SBRG_TABLE_SEL) & 3];
++	int ram, i;
