diff --git a/target/linux/sanechips/base-files/etc/hotplug.d/firmware/11-mt76-caldata b/target/linux/sanechips/base-files/etc/hotplug.d/firmware/11-mt76-caldata
new file mode 100644
index 0000000000..601f6f74da
--- /dev/null
+++ b/target/linux/sanechips/base-files/etc/hotplug.d/firmware/11-mt76-caldata
@@ -0,0 +1,38 @@
+#!/bin/sh
+
+[ -e /lib/firmware/$FIRMWARE ] && exit 0
+
+. /lib/functions/caldata.sh
+
+# The ZTE firmware keeps the MT7915 calibration as the file "caldata" in the
+# JFFS2 filesystem of the "wifi" partition.
+zte_caldata_from_jffs2() {
+	local part dir=/tmp/wifi-caldata
+
+	part=$(find_mtd_part wifi)
+	[ -n "$part" ] || caldata_die "no mtd device found for partition wifi"
+
+	mkdir -p $dir
+	mount -t jffs2 -o ro $part $dir || caldata_die "failed to mount $part"
+	# An MT7915 calibration starts with the chip ID 0x7915 (little endian)
+	if [ "$(hexdump -v -n 2 -e '2/1 "%02x"' $dir/caldata 2>/dev/null)" = "1579" ]; then
+		caldata_from_file $dir/caldata 0x0 0xe00
+	else
+		echo "caldata: no MT7915 calibration in $part"
+	fi
+	umount $dir
+	rmdir $dir
+}
+
+board=$(board_name)
+
+case "$FIRMWARE" in
+"mediatek/mt7915_eeprom.bin"|\
+"mediatek/mt7915_eeprom_dbdc.bin")
+	case "$board" in
+	zte,zxhn-h3600)
+		zte_caldata_from_jffs2
+		;;
+	esac
+	;;
+esac
diff --git a/target/linux/sanechips/base-files/etc/init.d/hw_switching b/target/linux/sanechips/base-files/etc/init.d/hw_switching
new file mode 100644
index 0000000000..50e0a9dd53
--- /dev/null
+++ b/target/linux/sanechips/base-files/etc/init.d/hw_switching
@@ -0,0 +1,26 @@
+#!/bin/sh /etc/rc.common
+# Hardware LAN switching of the ZX279128 switch (off by default):
+# hw_switching.settings.enabled, LuCI Network -> Firewall.
+
+START=25
+USE_PROCD=1
+
+SYSFS=/sys/devices/platform/soc/92000000.ethernet/hw_switching
+
+start_service() {
+	reload_service
+}
+
+service_triggers() {
+	procd_add_reload_trigger "hw_switching"
+}
+
+reload_service() {
+	local on="$(uci -q get hw_switching.settings.enabled)"
+
+	[ -w "$SYSFS" ] || return 0
+	case "$on" in
+	1|on|true|yes|enabled) echo 1 > "$SYSFS" ;;
+	*) echo 0 > "$SYSFS" ;;
+	esac
+}
diff --git a/target/linux/sanechips/base-files/etc/rc.button/lights_toggle b/target/linux/sanechips/base-files/etc/rc.button/lights_toggle
new file mode 100644
index 0000000000..c515e6c00c
--- /dev/null
+++ b/target/linux/sanechips/base-files/etc/rc.button/lights_toggle
@@ -0,0 +1,25 @@
+#!/bin/sh
+
+# LED on/off button: switch every LED off, and on the next press restore
+# the configured LED triggers and the power LED's status colour.
+
+OFF=/tmp/.lights_off
+
+case "$ACTION" in
+released)
+	if [ -e "$OFF" ]; then
+		rm -f "$OFF"
+		/etc/init.d/led restart
+		. /etc/diag.sh
+		set_state done
+	else
+		touch "$OFF"
+		for led in /sys/class/leds/*; do
+			echo none > "$led/trigger" 2>/dev/null
+			echo 0 > "$led/brightness"
+		done
+	fi
+;;
+esac
+
+return 0
diff --git a/target/linux/sanechips/base-files/etc/rc.wps/00-h3600-ledblink b/target/linux/sanechips/base-files/etc/rc.wps/00-h3600-ledblink
new file mode 100644
index 0000000000..d6a187f03c
--- /dev/null
+++ b/target/linux/sanechips/base-files/etc/rc.wps/00-h3600-ledblink
@@ -0,0 +1,16 @@
+#!/bin/sh
+# Starts the WPS LED blinking for the duration of the pushbutton window.
+# Always exits non-zero so /etc/rc.button/wps's dispatch loop continues on
+# to any real WPS-trigger script - this only handles the LED side.
+
+WPS_LED=/sys/class/leds/h3600:wps
+WPS_WINDOW=120
+
+if [ -e "$WPS_LED/trigger" ]; then
+	echo timer > "$WPS_LED/trigger"
+	echo 200 > "$WPS_LED/delay_on"
+	echo 200 > "$WPS_LED/delay_off"
+	( sleep "$WPS_WINDOW"; echo none > "$WPS_LED/trigger" 2>/dev/null; echo 0 > "$WPS_LED/brightness" 2>/dev/null ) &
+fi
+
+exit 1
