+ 	struct phy_device	*phydev[ZX_NUM_PORTS];
+ 	bool			link_state[ZX_NUM_PORTS];
+@@ -402,6 +440,8 @@ static void zx_port_enable(struct zx_eth
+ 
+ /* ---- PHY link callbacks -------------------------------------------- */
+ 
++static void zx_sw_port_down(struct zx_eth_adapter *adapter, int port);
++
