diff --git a/target/linux/sanechips/patches-6.18/011-zte-zx-eth-hw-switching.patch b/target/linux/sanechips/patches-6.18/011-zte-zx-eth-hw-switching.patch
new file mode 100644
index 0000000000..174067a148
--- /dev/null
+++ b/target/linux/sanechips/patches-6.18/011-zte-zx-eth-hw-switching.patch
@@ -0,0 +1,468 @@
+From: Navid Ghahremani <ghahramani.navid@gmail.com>
+Subject: [PATCH] net: ethernet: zte: zx279128: optional hardware LAN switching
+
+The switch's bridge block can forward unicast between its ports at line
+rate, but only through its VLAN table, which the driver leaves empty: all
+traffic between LAN ports goes through the Linux bridge on the CPU.
+
+Add a "hw_switching" attribute (off by default).  When set, the ports that
+are in the same Linux bridge switch between each other in hardware: they
+become untagged members of the port VLAN, may only send to the other ports
+of their bridge and learn source addresses, and the IPv4/IPv6 ethertype
+traps and the TCP-without-payload class are turned off.  Ports outside a
+bridge (normally the WAN) get an empty egress mask, so nothing is switched
+to or from them.  Frames for the router, broadcast, multicast and unknown
+unicast still go to the CPU, so hosts on other bridge ports (Wi-Fi) stay
+reachable through Linux.
+
+To keep a host reachable after it moves, a port's hardware entries are
+dropped when its link goes down, and a MAC is dropped from the switch
+table as soon as the Linux bridge learns it on a non-switch port (switchdev
+FDB notification).  Bridge membership changes are followed through netdev
+notifications.
+
+Signed-off-by: Navid Ghahremani <ghahramani.navid@gmail.com>
+---
+--- a/drivers/net/ethernet/zte/zx279128-eth.c
++++ b/drivers/net/ethernet/zte/zx279128-eth.c
+@@ -43,6 +43,9 @@
+ #include <linux/mutex.h>
+ #include <linux/rhashtable.h>
+ #include <net/flow_offload.h>
++#include <linux/bitfield.h>
++#include <linux/workqueue.h>
++#include <net/switchdev.h>
+ 
+ #define DRV_NAME		"zx279128-eth"
+ 
+@@ -60,6 +63,23 @@
+ #define ZX_SPA_ONU_MAC		0x1d4120	/* 16 x 8 bytes: our MACs, routed */
+ #define ZX_SPA_REG_PKT_TCP_ACK	BIT(4)		/* word 2: TCP without payload */
+ 
++/* Bridge block (sbrg); its ports: 0 PON side, 1-5 switch ports 0-4 */
++#define ZX_BRPORT(p)		((p) + 1)
++#define ZX_SBRG_PORT_CTRL	0x388004
++#define ZX_SBRG_FLUSH_PORTS	GENMASK(15, 8)	/* drop the entries of these */
++#define ZX_SBRG_FLUSH		BIT(16)
++#define ZX_SBRG_IND_CMD		0x388014	/* 27: read, 26-22: memory, 11-0: entry */
++#define ZX_SBRG_IND_READ	BIT(27)
++#define ZX_SBRG_IND_DONE	0x388018
++#define ZX_SBRG_IND_DATA(i)	(0x38801c + 4 * (i))
++#define ZX_SBRG_TABLE_SEL	0x388184	/* source table: 4 RAMs of 1024/256/512 */
++#define ZX_SBRG_LEARN		0x3881c0	/* ports that learn source MACs */
++#define ZX_SBRG_EGRESS(bp)	(0x3883c0 + 4 * (bp))	/* ports bp may send to */
++#define ZX_SBRG_MEM_VLAN	4		/* 1 word per VID */
++#define ZX_SBRG_VLAN_VALID	BIT(0)
++#define ZX_SBRG_VLAN_UNTAG(bp)	(1 << (2 * (bp) + 1))
++#define ZX_SW_FDB_QUEUE		16
++
+ /* Packet processor tables, reached through an indirect access window:
+  * command (index | table << 22 | read << 27), status bit 0 = idle, data.
+  * The classifier (CLA) has 17 data words, the packet modifier (PM) 8.
+@@ -240,6 +260,24 @@ struct zx_eth_adapter {
+ 	u32			ppe_add_skip;	/* flows the hardware cannot take */
