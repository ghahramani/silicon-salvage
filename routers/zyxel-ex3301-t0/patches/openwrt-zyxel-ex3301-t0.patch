+	ucidef_set_led_netdev "lan1" "LAN1" "mt7530-0:0b:green:lan-1" "lan1" "link tx rx"
+	ucidef_set_led_netdev "lan2" "LAN2" "mt7530-0:0a:green:lan-2" "lan2" "link tx rx"
+	ucidef_set_led_netdev "lan3" "LAN3" "mt7530-0:09:green:lan-3" "lan3" "link tx rx"
+	ucidef_set_led_netdev "lan4" "LAN4" "mt7530-0:08:green:lan-4" "lan4" "link tx rx"
+	ucidef_set_led_netdev "wan-port" "WAN Port" "mt7530-0:0c:green:wan" "wan" "link tx rx"
