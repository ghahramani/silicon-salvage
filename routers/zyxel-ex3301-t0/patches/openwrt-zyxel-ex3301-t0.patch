diff --git a/target/linux/econet/base-files/lib/preinit/81_mount_root_fallback b/target/linux/econet/base-files/lib/preinit/81_mount_root_fallback
new file mode 100644
index 0000000000..23650a43cd
--- /dev/null
+++ b/target/linux/econet/base-files/lib/preinit/81_mount_root_fallback
@@ -0,0 +1,15 @@
+check_rootfs_overlay() {
+	[ "$INITRAMFS" = "1" ] && return
+
+	# If the overlay mounted successfully, /etc is writable.
+	# If mounting failed (e.g. unformatted flash from stock or corrupted JFFS2),
+	# the rootfs remains read-only squashfs.
+	if ! touch /etc/.fs_writable 2>/dev/null; then
+		echo "Overlay mount failed, activating temporary RAM overlay..."
+		mount_root ram
+	else
+		rm -f /etc/.fs_writable
+	fi
+}
+
+boot_hook_add preinit_mount_root check_rootfs_overlay
diff --git a/target/linux/econet/base-files/lib/upgrade/platform.sh b/target/linux/econet/base-files/lib/upgrade/platform.sh
index 19c0072e63..0f84ea53b2 100644
--- a/target/linux/econet/base-files/lib/upgrade/platform.sh
+++ b/target/linux/econet/base-files/lib/upgrade/platform.sh
@@ -9,6 +9,17 @@ platform_check_image() {
 	jiofiber,jcow414)
 		return 0
 		;;
+	zyxel,ex3301-t0)
+		if fwtool -q -i /dev/null "$1"; then
+			return 0
+		fi
