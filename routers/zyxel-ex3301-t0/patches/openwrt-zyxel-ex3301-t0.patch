++			      MTK_PHY_LED_ON_POLARITY |
++			      MTK_GPHY_LED_ON_SET);
++		phy_write_mmd(phydev, MDIO_MMD_VEND2, MTK_PHY_LED1_BLINK_CTRL, 0x003f);
++	} else {
