diff --git a/target/linux/econet/patches-6.18/920-net-dsa-mt7530-skip-reset-for-en751627.patch b/target/linux/econet/patches-6.18/920-net-dsa-mt7530-skip-reset-for-en751627.patch
new file mode 100644
index 0000000000..a44264cbc0
--- /dev/null
+++ b/target/linux/econet/patches-6.18/920-net-dsa-mt7530-skip-reset-for-en751627.patch
@@ -0,0 +1,40 @@
+From: local
+Subject: net: dsa: mt7530: skip reset pulse in mt7988_setup for EN751627
+
+ID_EN751627 uses mt7988_setup, not mt7530_setup.
+This patch skips reset_control_assert and SYS_CTRL_PHY_RST in mt7988_setup
+for ID_EN751627 to avoid resetting switch PHY hardware initialized by bootloader.
+
+--- a/drivers/net/dsa/mt7530.c
++++ b/drivers/net/dsa/mt7530.c
+@@ -3298,10 +3298,12 @@ static int mt7988_setup(struct dsa_switc
+ 	struct mt7530_priv *priv = ds->priv;
+ 
+ 	/* Reset the switch */
+-	reset_control_assert(priv->rstc);
+-	usleep_range(20, 50);
+-	reset_control_deassert(priv->rstc);
+-	usleep_range(20, 50);
++	if (priv->id != ID_EN751627) {
++		reset_control_assert(priv->rstc);
++		usleep_range(20, 50);
++		reset_control_deassert(priv->rstc);
++		usleep_range(20, 50);
++	}
+ 
+ 	/* AN7583 require additional tweak to CONN_CFG */
+ 	if (priv->id == ID_AN7583)
+@@ -3315,7 +3317,12 @@ static int mt7988_setup(struct dsa_switc
+ 			   FIELD_PREP(AN7583_CSR_ETHER_AFE_PWD, 0));
+ 
+ 	/* Reset the switch PHYs */
+-	mt7530_write(priv, MT7530_SYS_CTRL, SYS_CTRL_PHY_RST);
++	if (priv->id != ID_EN751627) {
++		mt7530_write(priv, MT7530_SYS_CTRL, SYS_CTRL_PHY_RST);
++	} else {
++		mt7530_write(priv, MT7530_LED_EN, 0x77777);
++		mt7530_write(priv, MT7530_LED_IO_MODE, 0x77777);
++	}
+ 
+ 	return mt7531_setup_common(ds);
+ }
