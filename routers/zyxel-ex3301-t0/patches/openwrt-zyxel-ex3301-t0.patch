+@@ -1172,6 +1174,9 @@ static int mt798x_phy_calibration(struct
+ 	if (IS_ERR(cell)) {
+ 		if (PTR_ERR(cell) == -EPROBE_DEFER)
+ 			return PTR_ERR(cell);
++		phydev_warn(phydev,
++			    "no phy-cal-data nvmem cell (err=%ld), running UNCALIBRATED\n",
++			    PTR_ERR(cell));
+ 		return 0;
+ 	}
+ 
+@@ -1180,6 +1185,8 @@ static int mt798x_phy_calibration(struct
+ 	if (IS_ERR(buf))
+ 		return PTR_ERR(buf);
+ 
++	phydev_warn(phydev, "phy-cal-data nvmem cell found, applying calibration\n");
++
+ 	if (!buf[0] || !buf[1] || !buf[2] || !buf[3] || len < 4 * sizeof(u32)) {
+ 		phydev_err(phydev, "invalid efuse data\n");
+ 		ret = -EINVAL;
+@@ -1285,6 +1292,12 @@ static int mt798x_phy_led_hw_control_get
+ static int mt798x_phy_led_hw_control_set(struct phy_device *phydev, u8 index,
