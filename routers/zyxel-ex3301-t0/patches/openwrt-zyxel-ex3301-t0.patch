diff --git a/package/kernel/econet-eth/patches/001-en751627-support.patch b/package/kernel/econet-eth/patches/001-en751627-support.patch
new file mode 100644
index 0000000000..eb5f34e48b
--- /dev/null
+++ b/package/kernel/econet-eth/patches/001-en751627-support.patch
@@ -0,0 +1,40 @@
+AUDIT 2026-09-11: the byte-order assumption below is incorrect. Patch 005
+corrects it for this big-endian target. DSCP here means DMA descriptor,
+not IP DSCP/QoS. Retained below as the history of this local patch.
+
+WIP / UNTESTED: add EN751627 to the SoC match table, copying en7528's
+dscp_byte_swap=false rather than en751221's, on the grounds that EN751627
+uses the same airoha,en7523-scu / EN7523_* reset binding as EN7528 (confirmed
+from the actual devicetree sources in this tree) rather than en751221's
+separate econet,en751221-scu binding. This value has not been verified
+against real EN751627 hardware.
+
+Needed for target/linux/econet's en751627_zyxel_ex3301-t0.dts, which now
+enables &ethernet/&switch using compatible = "econet,en751627-eth" /
+"econet,en751627-switch".
+
+--- a/econet_eth.c
++++ b/econet_eth.c
+@@ -431,9 +431,22 @@ static const struct en75_soc_data en7528_soc_data = {
+ 	.dscp_byte_swap = false,
+ };
+
++/*
++ * UNTESTED GUESS: EN751627 shares en7528's scu/reset binding (both use
++ * airoha,en7523-scu / EN7523_* reset constants, confirmed from the actual
++ * devicetree source), so this copies en7528_soc_data's value rather than
++ * en751221's. dscp_byte_swap has not been verified against real EN751627
++ * hardware -- if DSCP/QoS marking comes out wrong on this SoC, this is the
++ * first thing to flip.
++ */
++static const struct en75_soc_data en751627_soc_data = {
++	.dscp_byte_swap = false,
++};
++
+ static const struct of_device_id of_en75_match[] = {
+ 	{ .compatible = "econet,en751221-eth", .data = &en751221_soc_data },
+ 	{ .compatible = "econet,en7528-eth", .data = &en7528_soc_data },
++	{ .compatible = "econet,en751627-eth", .data = &en751627_soc_data },
+ 	{ /* sentinel */ }
+ };
+ MODULE_DEVICE_TABLE(of, of_en75_match);
diff --git a/package/kernel/econet-eth/patches/002-fix-reg-lock-held-across-qdma-use.patch b/package/kernel/econet-eth/patches/002-fix-reg-lock-held-across-qdma-use.patch
new file mode 100644
index 0000000000..e1c34aec2e
--- /dev/null
+++ b/package/kernel/econet-eth/patches/002-fix-reg-lock-held-across-qdma-use.patch
@@ -0,0 +1,60 @@
+From: local
+Subject: econet-eth: don't hold port->reg_lock (spinlock) across en75_qdma_use (mutex)
+
+Confirmed by CONFIG_PROVE_LOCKING (lockdep) on real EN751627 hardware:
+
+  [ BUG: Invalid wait context ]
+  netifd/2091 is trying to lock:
+  (&qdma->lock){....}-{3:3}, at: en75_qdma_use+0x1c/0xe8 [econet_eth]
+  context-{4:4}
+  2 locks held by netifd/2091:
+   #0: (rtnl_mutex){+.+.}-{3:3}, at: dev_ioctl+0x2cc/0x5f0
+   #1: (&port->reg_lock){+.+.}-{2:2}, at: en75_qdma_new+0xe90/0x20bc [econet_eth]
+
+en75_dev_open() takes port->reg_lock (a spinlock) via guard(spinlock), whose
+scope extends to the end of the function per its C cleanup-attribute
+semantics -- and en75_qdma_use() (still called within that scope, at the
+function's `return` statement) takes qdma->lock via mutex_lock_nested().
+Taking a sleeping-capable lock (mutex) while holding a non-sleeping one
+(spinlock) is what lockdep's wait-context check exists to catch.
+
+Every other guard(spinlock)(&port->reg_lock) call site in this file (in
+en75_set_gdm_port_fwd_cfg and en75_dev_change_mtu) has nothing after it
+that can sleep, so this appears to be the only site affected. The intended
+scope was almost certainly just the three register accesses immediately
+following the lock -- en75_set_macaddr() elsewhere in this same file
+already uses scoped_guard(spinlock, ...) { ... } for exactly this reason.
+Narrowing en75_dev_open's spinlock to a scoped_guard around just those
+register accesses (matching that existing style) drops the lock before
+en75_qdma_use() is reached, resolving the invalid wait context with no
+change in what's actually protected.
+
+This function (en75_qdma_new, which en75_dev_open's call path runs
+through) is also the exact function present in every stack trace of a
+separate, severe symptom: en75_qdma_xmit() permanently deadlocking under
+periodic multicast transmit load (see upstream bug report for the full
+writeup). Not yet confirmed whether this is the same root cause manifesting
+at a different call site, or a related-but-distinct locking issue in the
+same function -- testing against real hardware to see whether this specific
+fix also resolves the periodic deadlock, not just the boot-time lockdep hit.
+
+--- a/econet_port.c
++++ b/econet_port.c
+@@ -153,11 +153,12 @@ static int en75_dev_open(struct net_device *dev)
+ 	// 	airoha_fe_clear(qdma->eth, REG_GDM_INGRESS_CFG(port->id),
+ 	// 			GDM_STAG_EN_MASK);
+
+-	guard(spinlock)(&port->reg_lock);
+-	rlt = en75_rreg(&port->regs->rx_len_threshold);
+-	set_gdm_len_th_runt_len(&rlt, 60);
+-	set_gdm_len_th_oversize_len(&rlt, ETH_HLEN + dev->mtu + ETH_FCS_LEN);
+-	en75_wreg(rlt, &port->regs->rx_len_threshold);
++	scoped_guard(spinlock, &port->reg_lock) {
++		rlt = en75_rreg(&port->regs->rx_len_threshold);
++		set_gdm_len_th_runt_len(&rlt, 60);
++		set_gdm_len_th_oversize_len(&rlt, ETH_HLEN + dev->mtu + ETH_FCS_LEN);
++		en75_wreg(rlt, &port->regs->rx_len_threshold);
++	}
+
+ 	return en75_qdma_use(port->qdma);
+ }
diff --git a/package/kernel/econet-eth/patches/003-remove-unexpected-fport-print.patch b/package/kernel/econet-eth/patches/003-remove-unexpected-fport-print.patch
new file mode 100644
index 0000000000..b5d57bd43a
--- /dev/null
+++ b/package/kernel/econet-eth/patches/003-remove-unexpected-fport-print.patch
@@ -0,0 +1,30 @@
+From: local
+Subject: econet-eth: remove the "rx: on unexpected fport" print entirely
+
+CORRECTED RATIONALE (this patch previously rate-limited, then
+debug-leveled, this print as a hypothesis for the periodic full-router
+hang investigated in the qdma deadlock bug report; that hang's real
+cause is now confirmed to be an unmasked ERR_COHERENT IRQ storm, fixed
+separately in patch 004, and is unrelated to this print or its
+volume -- see that patch and the bug report for the actual root
+cause).
+
+This message was emitted by en75_get_sport_dev() for every received
+packet whose fport is neither GDM1 nor GDM2 (typically CPU-port
+loopback/reflected traffic). It is expected, benign, informational
+noise -- the packet is still delivered correctly either way, to
+ports[0], identically regardless of this check -- not an error
+condition worth keeping any trace of, so the check and its print are
+removed outright rather than merely down-leveled.
+
+--- a/econet_eth.c
++++ b/econet_eth.c
+@@ -148,8 +148,6 @@ static struct net_device *en75_get_sport_dev(struct en75_eth_pvt *eth,
+ 	if (sport == ETX_FPORT_GDM2) {
+ 		return eth->ports[1];
+ 	} else {
+-		if (sport != ETX_FPORT_GDM1)
+-			dev_info(eth->pub.dev, "rx: on unexpected fport %d\n", sport);
+ 		return eth->ports[0];
+ 	}
+ }
diff --git a/package/kernel/econet-eth/patches/004-fix-unmasked-error-irq-storm.patch b/package/kernel/econet-eth/patches/004-fix-unmasked-error-irq-storm.patch
new file mode 100644
index 0000000000..f298a795d2
--- /dev/null
+++ b/package/kernel/econet-eth/patches/004-fix-unmasked-error-irq-storm.patch
@@ -0,0 +1,83 @@
+From: local
+Subject: econet-eth: mask non-DONE IRQ purposes after they fire, not just DONE
+
+ROOT CAUSE CONFIRMED on real EN751627 hardware -- this is the actual
+cause of the periodic full-router hang investigated in the qdma
+deadlock bug report, not the reg_lock bug (patch 002, real but
+separate) and not the "rx: on unexpected fport 0" print rate (patch
+003, a red herring -- reverting that hypothesis is not necessary since
+the fix is harmless on its own, but it did not fix this).
+
+Confirmed via the driver's own debugfs interrupt counters
+(/sys/kernel/debug/econet_eth/qdma0/interrupts) while the router was
+hung and completely unresponsive on one CPU (but still answering
+hardware IRQs/IPIs -- confirmed via /proc/interrupts and a forced
+`echo l > /proc/sysrq-trigger` NMI backtrace, both showing the same
+CPU frozen at the same PC, inside handle_softirqs(), for 30+ minutes
+straight, immune to SIGKILL, immune to SIGSTOP):
+
+  count      irq  reg  bit  origin  chain  meaning
+  692542517  0    0    12   TX      0      ERR_COHERENT
+       522   0    0    1    RX      0      DONE
+       522   0    0    11   UNSPEC  -1     OVERFLOW
+
+692 million and climbing, against normal (double-digit/low-hundreds)
+counts for every legitimate RX/TX-done interrupt in the same window.
+/proc/interrupts corroborated this at the whole-line level: the
+econet_eth-0.0 IRQ alone had over 650 million hits, entirely on one
+CPU, versus a few hundred thousand for that CPU's own local timer
+over the same uptime -- roughly a quarter million interrupts/second,
+sustained, since shortly after boot.
+
+en75_init_final() deliberately enables (leaves unmasked) several IRQ
+purposes beyond plain RX/TX DONE, including IPS_ERR_COHERENT,
+IPS_OVERFLOW, IPS_NO_DSCP, IPS_LOW_DSCP, and the PON external-hardware
+interrupts -- clearly intended to be rare/exceptional conditions worth
+logging. But en75_irq_handler()'s dispatch loop only ever adds a bit
+to disable_int (masking it until something explicitly re-enables it,
+mirroring how DONE relies on NAPI to re-enable via
+en75_qdma_set_irqmask() once the poll completes) for
+IPS_DONE+IPSC_RX and IPS_DONE+IPSC_TX. Every other enabled purpose
+falls through to a plain dev_dbg_ratelimited() call and is never
+masked. If the underlying hardware condition for one of those other
+purposes is ever continuously true rather than a one-off event (as
+ERR_COHERENT/chain 0/TX is on this board), the interrupt re-fires as
+fast as the bus allows, forever -- and since dev_dbg_ratelimited() is
+compiled in but silent by default (no dynamic debug enabled), this
+happened with literally zero visible trace in dmesg/logread the whole
+time, despite completely wedging one CPU core permanently.
+
+Fix: mask (add to disable_int) every purpose that reaches the
+fallback branch too, exactly like the two DONE cases already do --
+the only difference being nothing re-enables these bits afterward
+(no NAPI-equivalent poll/re-arm exists for "rare error condition"
+purposes), which is the correct, conservative behavior for something
+that is only ever supposed to happen rarely: log it once (now at
+dev_warn_ratelimited so it is actually visible by default, instead of
+silent debug level), then leave it masked rather than let it
+potentially free-run. Also directly explains why RX still nominally
+worked throughout the hang (the RX-done path was never touched by
+this) and why the box stayed otherwise responsive (only the one CPU
+core handling this IRQ line was affected).
+
+Not yet confirmed why chain 0/TX hits a coherency error at all on
+this board -- that is a separate, deeper DMA/cache-coherency question
+this fix does not answer, only prevents from being catastrophic.
+
+--- a/econet_qdma.c
++++ b/econet_qdma.c
+@@ -408,11 +408,12 @@ static irqreturn_t en75_irq_handler(int irq_num, void *dev_instance)
+ 				disable_int |= BIT(bit);
+ 				continue;
+ 			}
+-			dev_dbg_ratelimited(qdma->dev,
+-					    "%s IRQ from %s[%d]\n",
++			dev_warn_ratelimited(qdma->dev,
++					    "%s IRQ from %s[%d], masking\n",
+ 					    en75_irq_purpose_type_str(p.type),
+ 					    en75_irq_purpose_source_str(p.source),
+ 					    p.chain);
++			disable_int |= BIT(bit);
+ 		}
+ 
+ 		irq->irqmask[i] &= ~disable_int;
diff --git a/package/kernel/econet-eth/patches/005-fix-en751627-dma-descriptor-byte-order.patch b/package/kernel/econet-eth/patches/005-fix-en751627-dma-descriptor-byte-order.patch
new file mode 100644
index 0000000000..57348043bc
--- /dev/null
+++ b/package/kernel/econet-eth/patches/005-fix-en751627-dma-descriptor-byte-order.patch
@@ -0,0 +1,42 @@
+From: local
+Subject: econet-eth: enable descriptor byte swapping on big-endian EN751627
+
+Patch 001 copied the EN7528 setting based on reset-controller similarity
+and incorrectly described dscp_byte_swap as an IP DSCP/QoS option. This
+flag controls the byte order of DMA packet descriptors, including packet
+addresses, lengths and next-descriptor indices. The driver writes those
+fields in native CPU byte order.
+
+The EN751627 target has CONFIG_CPU_BIG_ENDIAN=y, like EN751221, whose
+descriptor-swap setting is true. EN7528 has CONFIG_CPU_LITTLE_ENDIAN=y.
+Upstream commit 90b6d9b2c0e024fb17cc6abe8ec306673011caeb ("en7528 little
+endian support") introduced the per-SoC flag in place of unconditional
+descriptor swapping. The qdma_regs.h accessor also identifies this as
+descriptor endian swapping used on big-endian machines.
+
+Enable descriptor swapping for EN751627. Keep the existing IRQ storm
+guard: suppressing repeated ERR_COHERENT interrupts does not repair the
+underlying DMA failure. Whether this correction resolves the observed
+LAN data-path failure still requires testing on the EX3301-T0.
+
+--- a/econet_eth.c
++++ b/econet_eth.c
+@@ -430,15 +430,11 @@
+ };
+ 
+ /*
+- * UNTESTED GUESS: EN751627 shares en7528's scu/reset binding (both use
+- * airoha,en7523-scu / EN7523_* reset constants, confirmed from the actual
+- * devicetree source), so this copies en7528_soc_data's value rather than
+- * en751221's. dscp_byte_swap has not been verified against real EN751627
+- * hardware -- if DSCP/QoS marking comes out wrong on this SoC, this is the
+- * first thing to flip.
++ * EN751627 uses native big-endian DMA descriptors, like EN751221.
++ * DSCP here means descriptor; this setting does not control IP DSCP/QoS.
+  */
+ static const struct en75_soc_data en751627_soc_data = {
+-	.dscp_byte_swap = false,
++	.dscp_byte_swap = true,
+ };
+ 
+ static const struct of_device_id of_en75_match[] = {
diff --git a/package/system/fstools/patches/0001-mtd-identify-nand-without-oob-cleanmarkers-as-jffs2.patch b/package/system/fstools/patches/0001-mtd-identify-nand-without-oob-cleanmarkers-as-jffs2.patch
