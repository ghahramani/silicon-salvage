++		phy_write_mmd(phydev, MDIO_MMD_VEND2, MTK_PHY_LED_DUR_BLINK, 0x1400);
++	}
++
+ 	return mtk_phy_led_hw_ctrl_set(phydev, index, rules,
+ 				       MTK_GPHY_LED_ON_SET,
+ 				       MTK_GPHY_LED_RX_BLINK_SET,
+@@ -1296,6 +1309,9 @@ static bool mt7988_phy_led_get_polarity(
+ 	struct mtk_socphy_shared *priv = phy_package_get_priv(phydev);
+ 	u32 polarities;
+ 
++	if (phydev->mdio.addr >= 8 && phydev->mdio.addr <= 12)
++		return true;
++
+ 	if (led_num == 0)
+ 		polarities = ~(priv->boottrap);
+ 	else
+@@ -1352,8 +1368,14 @@ static int mt7988_phy_probe_shared(struc
+ 	 * set LED polarity for each of the LED0.
