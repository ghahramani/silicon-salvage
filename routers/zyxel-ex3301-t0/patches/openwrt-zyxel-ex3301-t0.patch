diff --git a/target/linux/econet/patches-6.18/916-net-dsa-mt7530-add-en751627-support.patch b/target/linux/econet/patches-6.18/916-net-dsa-mt7530-add-en751627-support.patch
new file mode 100644
index 0000000000..ea360da3da
--- /dev/null
+++ b/target/linux/econet/patches-6.18/916-net-dsa-mt7530-add-en751627-support.patch
@@ -0,0 +1,105 @@
+From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
+From: Navid Ghahremani <ghahramani.navid@gmail.com>
+Date: Sun, 27 Sep 2026 22:20:00 +0100
+Subject: [PATCH] net: dsa: mt7530: add EN751627 support
+
+Add EN751627 support to MT7530 DSA driver matching switch MMIO glue and port mapping.
+
+Signed-off-by: Navid Ghahremani <ghahramani.navid@gmail.com>
+---
+--- a/drivers/net/dsa/mt7530.h
++++ b/drivers/net/dsa/mt7530.h
+@@ -22,6 +22,7 @@ enum mt753x_id {
+ 	ID_EN7581 = 4,
+ 	ID_AN7583 = 5,
+ 	ID_EN7528 = 6,
++	ID_EN751627 = 7,
+ };
+
+ #define	NUM_TRGMII_CTRL			5
+--- a/drivers/net/dsa/mt7530-mmio.c
++++ b/drivers/net/dsa/mt7530-mmio.c
+@@ -14,6 +14,7 @@ static const struct of_device_id mt7988_
+ 	{ .compatible = "airoha,an7583-switch", .data = &mt753x_table[ID_AN7583], },
+ 	{ .compatible = "airoha,en7581-switch", .data = &mt753x_table[ID_EN7581], },
+ 	{ .compatible = "econet,en7528-switch", .data = &mt753x_table[ID_EN7528], },
++	{ .compatible = "econet,en751627-switch", .data = &mt753x_table[ID_EN751627], },
+ 	{ .compatible = "mediatek,mt7988-switch", .data = &mt753x_table[ID_MT7988], },
+ 	{ /* sentinel */ },
+ };
+--- a/drivers/net/dsa/mt7530.c
++++ b/drivers/net/dsa/mt7530.c
+@@ -2853,6 +2853,38 @@ static void en7528_mac_port_get_caps(str
+ 	}
+ }
+
++/*
++ * EN751627 uses the same switch core as EN7528, but on the Zyxel
++ * EX3301-T0 all five user ports (0-4) are wired out, not just 1-4 -- port 0
++ * is a real LAN port on this board (confirmed by live-plugging cables and
++ * reading /proc/tc3162/gsw_link_st on the vendor firmware, see
++ * en751627_zyxel_ex3301-t0.dts for the exact port map). Otherwise identical
++ * to en7528_mac_port_get_caps.
++ */
++static void en751627_mac_port_get_caps(struct dsa_switch *ds, int port,
++				     struct phylink_config *config)
++{
++	switch (port) {
++	/* Ports which are connected to switch PHYs. There is no MII pinout. */
++	case 0 ... 4:
++		__set_bit(PHY_INTERFACE_MODE_INTERNAL,
++			  config->supported_interfaces);
++
++		config->mac_capabilities |= MAC_10 | MAC_100 | MAC_1000FD;
++		break;
++
++	/* Port 6 is connected to SoC's GMAC at 1000 Mbps full duplex. There
++	 * is no MII pinout.
++	 */
++	case 6:
++		__set_bit(PHY_INTERFACE_MODE_INTERNAL,
++			  config->supported_interfaces);
++
++		config->mac_capabilities |= MAC_1000FD;
++		break;
++	}
++}
++
+ static void
+ mt7530_mac_config(struct dsa_switch *ds, int port, unsigned int mode,
+ 		  phy_interface_t interface)
+@@ -3053,7 +3085,7 @@ static void mt753x_phylink_get_caps(stru
+ 	 * phylink disables EEE on these PHYs and refuses to enable it from
+ 	 * userspace.
+ 	 */
+-	if (priv->id != ID_EN7528 &&
++	if (priv->id != ID_EN7528 && priv->id != ID_EN751627 &&
+ 	    config->mac_capabilities & (MAC_100FD | MAC_1000FD)) {
+ 		u32 eeecr = mt7530_read(priv, MT753X_PMEEECR_P(port));
+
+@@ -3196,7 +3228,7 @@ mt753x_conduit_state_change(struct dsa_s
+ 	 * interface is up.
+ 	 */
+ 	if (priv->id != ID_MT7530 && priv->id != ID_MT7621 &&
+-	    priv->id != ID_EN7528)
++	    priv->id != ID_EN7528 && priv->id != ID_EN751627)
+ 		return;
+
+ 	mask = BIT(cpu_dp->index);
+@@ -3409,6 +3441,16 @@ const struct mt753x_info mt753x_table[]
+ 		.phy_write_c45 = mt7531_ind_c45_phy_write,
+ 		.mac_port_get_caps = en7528_mac_port_get_caps,
+ 	},
++	[ID_EN751627] = {
++		.id = ID_EN751627,
++		.pcs_ops = &mt7530_pcs_ops,
++		.sw_setup = mt7988_setup,
++		.phy_read_c22 = mt7531_ind_c22_phy_read,
++		.phy_write_c22 = mt7531_ind_c22_phy_write,
++		.phy_read_c45 = mt7531_ind_c45_phy_read,
++		.phy_write_c45 = mt7531_ind_c45_phy_write,
++		.mac_port_get_caps = en751627_mac_port_get_caps,
++	},
+ };
+ EXPORT_SYMBOL_GPL(mt753x_table);
+
diff --git a/target/linux/econet/patches-6.18/917-phy-mediatek-accept-mt7988-phy-at-addr-8-12.patch b/target/linux/econet/patches-6.18/917-phy-mediatek-accept-mt7988-phy-at-addr-8-12.patch
new file mode 100644
index 0000000000..390c8f4200
--- /dev/null
+++ b/target/linux/econet/patches-6.18/917-phy-mediatek-accept-mt7988-phy-at-addr-8-12.patch
@@ -0,0 +1,136 @@
+From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
+From: Navid Ghahremani <ghahramani.navid@gmail.com>
+Date: Sun, 27 Sep 2026 22:20:00 +0100
+Subject: [PATCH] net: phy: mediatek: accept MT7988-ID PHYs wired at MDIO address 8-12
+
+Widen mt7988_phy_probe address acceptance to MDIO addresses 8-12 and fix LED polarity.
+
+Signed-off-by: Navid Ghahremani <ghahramani.navid@gmail.com>
+---
+--- a/drivers/net/phy/mediatek/mtk-ge-soc.c
++++ b/drivers/net/phy/mediatek/mtk-ge-soc.c
+@@ -328,6 +328,10 @@
+ #define MTK_PHY_LED_BCR				0x21
+ #define   MTK_PHY_LED_BCR_CLK_EN		BIT(3)
+ #define   MTK_PHY_LED_BCR_EXT_CTRL		BIT(15)
++#define MTK_PHY_LED_DUR_ON			0x22
++#define   MTK_PHY_LED_DUR_ON_DEF		0x0c00
++#define MTK_PHY_LED_DUR_BLINK			0x23
++#define   MTK_PHY_LED_DUR_BLINK_DEF		0x1400
+
+ #define MTK_PHY_RG_BG_RASEL			0x115
+ #define   MTK_PHY_RG_BG_RASEL_MASK		GENMASK(2, 0)
+@@ -383,7 +385,7 @@ enum CAL_MODE {
+
+ struct mtk_socphy_shared {
+ 	u32			boottrap;
+-	struct mtk_socphy_priv	priv[4];
++	struct mtk_socphy_priv	priv[5];
+ };
+
+ /* One calibration cycle consists of:
+@@ -1172,6 +1174,9 @@ static int mt798x_phy_calibration(struct
+ 	if (IS_ERR(cell)) {
+ 		if (PTR_ERR(cell) == -EPROBE_DEFER)
+ 			return PTR_ERR(cell);
++		phydev_dbg(phydev,
++			   "no phy-cal-data nvmem cell (err=%ld), running UNCALIBRATED\n",
++			   PTR_ERR(cell));
+ 		return 0;
+ 	}
+
+@@ -1180,6 +1185,8 @@ static int mt798x_phy_calibration(struct
+ 	if (IS_ERR(buf))
+ 		return PTR_ERR(buf);
+
++	phydev_dbg(phydev, "phy-cal-data nvmem cell found, applying calibration\n");
++
+ 	if (!buf[0] || !buf[1] || !buf[2] || !buf[3] || len < 4 * sizeof(u32)) {
+ 		phydev_err(phydev, "invalid efuse data\n");
+ 		ret = -EINVAL;
+@@ -1296,6 +1303,9 @@ static bool mt7988_phy_led_get_polarity(
+ 	struct mtk_socphy_shared *priv = phy_package_get_priv(phydev);
+ 	u32 polarities;
+
++	if (phydev->mdio.addr >= 8 && phydev->mdio.addr <= 12)
++		return true;
++
+ 	if (led_num == 0)
+ 		polarities = ~(priv->boottrap);
+ 	else
+@@ -1352,8 +1362,14 @@ static int mt7988_phy_probe_shared(struct mii_bus *bus)
+ 	 * set LED polarity for each of the LED0.
+ 	 */
+ 	pio_np = of_parse_phandle(np, "mediatek,pio", 0);
+-	if (!pio_np)
+-		return -ENODEV;
++	if (!pio_np) {
++		/* Not present on SoCs that don't bootstrap configuration
++		 * through the PHY LED pins (e.g. EN751627) -- fall back to
++		 * a neutral boottrap value instead of failing probe.
++		 */
