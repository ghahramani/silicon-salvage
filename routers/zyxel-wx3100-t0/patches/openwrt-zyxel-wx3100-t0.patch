From 3ef0fc3df9ed3dffdf083563e74f7afedc5f3314 Mon Sep 17 00:00:00 2001
From: Navid Ghahremani <ghahramani.navid@gmail.com>
Date: Mon, 28 Sep 2026 07:06:26 +0100
Subject: [PATCH] econet: add support for Zyxel WX3100-T0

The Zyxel WX3100-T0 is a Wi-Fi 6 access point / repeater on the
EcoNet EN751627 SoC, like the EX3301-T0:

- SoC:      EcoNet EN751627
- Flash:    SPI-NAND
- Ethernet: 2x 1 GbE on the built-in switch (lan1, lan2)
- Wi-Fi:    MediaTek MT7915 (2.4 GHz + 5 GHz 802.11ax), PCIe
- LEDs:     power, link, Wi-Fi, WPS

Both ports are bridged as LAN by default. Settings persist as on the
EX3301-T0 (writable rootfs_data, BBT table size of the bootloader, no
dynamic BMT remapping of the tclinux partition, the BMT reserve blocks
protected), and sysupgrade works the same way.

Signed-off-by: Navid Ghahremani <ghahramani.navid@gmail.com>
Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../econet/base-files/etc/board.d/01_leds     |   6 +
 .../econet/base-files/etc/board.d/02_network  |   3 +
 .../econet/base-files/lib/upgrade/platform.sh |   6 +-
 .../linux/econet/base-files/sbin/en75_chboot  |   3 +-
 .../econet/dts/en751627_zyxel_wx3100-t0.dts   | 216 ++++++++++++++++++
 target/linux/econet/image/en751627.mk         |  12 +-
 6 files changed, 242 insertions(+), 4 deletions(-)
 create mode 100644 target/linux/econet/dts/en751627_zyxel_wx3100-t0.dts

diff --git a/target/linux/econet/base-files/etc/board.d/01_leds b/target/linux/econet/base-files/etc/board.d/01_leds
index 858eaa3db0..912f298d3d 100644
--- a/target/linux/econet/base-files/etc/board.d/01_leds
+++ b/target/linux/econet/base-files/etc/board.d/01_leds
@@ -48,6 +48,12 @@ zyxel,ex3301-t0)
 	ucidef_set_led_netdev "lan4" "LAN4" "mt7530-0:08:green:lan-4" "lan4" "link tx rx"
 	ucidef_set_led_netdev "wan-port" "WAN Port" "mt7530-0:0c:green:wan" "wan" "link tx rx"
 	;;
+zyxel,wx3100-t0)
+	ucidef_set_led_default "power" "Power" "green:power" "1"
+	ucidef_set_led_netdev "link" "Link" "green:link" "br-lan" "link tx rx"
+	ucidef_set_led_wlan "wifi" "Wi-Fi" "green:wifi" "phy0tpt"
+	ucidef_set_led_wlan "wps" "WPS" "green:wps" "phy1tpt"
+	;;
 esac
 
 board_config_flush
diff --git a/target/linux/econet/base-files/etc/board.d/02_network b/target/linux/econet/base-files/etc/board.d/02_network
index 1b88f7c266..0f6e335c07 100644
--- a/target/linux/econet/base-files/etc/board.d/02_network
+++ b/target/linux/econet/base-files/etc/board.d/02_network
@@ -17,6 +17,9 @@ econet_setup_interfaces()
 	zyxel,ex3301-t0)
 		ucidef_set_interfaces_lan_wan "lan1 lan2 lan3 lan4" "wan"
 		;;
+	zyxel,wx3100-t0)
+		ucidef_set_interface_lan "lan1 lan2"
+		;;
 	*)
 		# The remaining boards have no DSA switch driver yet.
 		ucidef_set_interface_lan "eth0"
diff --git a/target/linux/econet/base-files/lib/upgrade/platform.sh b/target/linux/econet/base-files/lib/upgrade/platform.sh
index 0f84ea53b2..f263a219d8 100644
--- a/target/linux/econet/base-files/lib/upgrade/platform.sh
+++ b/target/linux/econet/base-files/lib/upgrade/platform.sh
@@ -9,7 +9,8 @@ platform_check_image() {
 	jiofiber,jcow414)
 		return 0
 		;;
-	zyxel,ex3301-t0)
+	zyxel,ex3301-t0|\
+	zyxel,wx3100-t0)
 		if fwtool -q -i /dev/null "$1"; then
 			return 0
 		fi
@@ -37,7 +38,8 @@ platform_do_upgrade() {
 		CI_KERNPART="tclinux_kernel"
 		nand_do_upgrade "$1"
 		;;
-	zyxel,ex3301-t0)
+	zyxel,ex3301-t0|\
+	zyxel,wx3100-t0)
 		PART_NAME="tclinux"
 		MTD_ARGS="-e rootfs_data"
 		default_do_upgrade "$1"
diff --git a/target/linux/econet/base-files/sbin/en75_chboot b/target/linux/econet/base-files/sbin/en75_chboot
index 165a3ebb7b..cf1174c3f0 100755
--- a/target/linux/econet/base-files/sbin/en75_chboot
+++ b/target/linux/econet/base-files/sbin/en75_chboot
@@ -137,7 +137,8 @@ main() {
         code_openwrt=30000000
         code_factory=31000000
         ;;
-    zyxel,ex3301-t0)
+    zyxel,ex3301-t0|\
+    zyxel,wx3100-t0)
         part=$(part_named '"reservearea"')
         offset_blocks=5
         block_size=$((1024 * 128))
diff --git a/target/linux/econet/dts/en751627_zyxel_wx3100-t0.dts b/target/linux/econet/dts/en751627_zyxel_wx3100-t0.dts
new file mode 100644
index 0000000000..fe28b84e85
--- /dev/null
+++ b/target/linux/econet/dts/en751627_zyxel_wx3100-t0.dts
@@ -0,0 +1,216 @@
+// SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+/dts-v1/;
+
+#include "en751627.dtsi"
+#include <dt-bindings/gpio/gpio.h>
+#include <dt-bindings/input/input.h>
+#include <dt-bindings/leds/common.h>
+
+/ {
+	model = "Zyxel WX3100-T0";
+	compatible = "zyxel,wx3100-t0", "econet,en751627";
+
+	aliases {
+		led-boot = &led_power_green;
+		led-failsafe = &led_power_red;
+		led-running = &led_power_green;
+		led-upgrade = &led_power_red;
+	};
+
+	memory@0 {
+		device_type = "memory";
+		reg = <0x00000000 0x10000000>;
+	};
+
+	chosen {
+		stdout-path = "/serial@1fbf0000:115200";
+	};
+
+	leds {
+		compatible = "gpio-leds";
+
+		led_power_green: power-green {
+			label = "green:power";
+			gpios = <&gpio0 8 GPIO_ACTIVE_HIGH>;
+			default-state = "on";
+		};
+
+		led_power_red: power-red {
+			label = "red:power";
+			gpios = <&gpio0 6 GPIO_ACTIVE_HIGH>;
+			default-state = "off";
+		};
+
+		led_link: link {
+			label = "green:link";
+			gpios = <&gpio0 4 GPIO_ACTIVE_LOW>;
+			default-state = "off";
+		};
+
+		led_wifi: wifi {
+			label = "green:wifi";
+			gpios = <&gpio0 20 GPIO_ACTIVE_LOW>;
+			linux,default-trigger = "phy0tpt";
+			default-state = "off";
+		};
+
+		led_wps: wps {
+			label = "green:wps";
+			gpios = <&gpio0 23 GPIO_ACTIVE_HIGH>;
+			default-state = "off";
+		};
+	};
+
+	keys {
+		compatible = "gpio-keys";
+
+		key-reset {
+			label = "reset";
+			gpios = <&gpio0 0 GPIO_ACTIVE_LOW>;
+			linux,code = <KEY_RESTART>;
+		};
+
+		key-wps {
+			label = "wps";
+			gpios = <&gpio0 16 GPIO_ACTIVE_LOW>;
+			linux,code = <KEY_WPS_BUTTON>;
+		};
+	};
+};
+
+&nand {
+	status = "okay";
+	econet,bmt;
+	econet,bbt-table-size = <250>;
+
+	partitions {
+		compatible = "fixed-partitions";
+		#address-cells = <1>;
+		#size-cells = <1>;
+
+		partition@0all {
+			label = "all_of_flash";
+			reg = <0x0 0x8000000>;
+			read-only;
+		};
+
+		partition@0 {
+			label = "bootloader";
+			reg = <0x0 0x40000>;
+			read-only;
+		};
+
+		partition@40000 {
+			label = "romfile";
+			reg = <0x40000 0x40000>;
+			read-only;
+		};
+
+		partition@80000 {
+			label = "tclinux";
+			reg = <0x80000 0x2800000>;
+		};
+
+		/* Nested inside of tclinux */
+		partition@480000 {
+			label = "rootfs";
+			reg = <0x480000 0x2400000>;
+			linux,rootfs;
+		};
+
+		partition@2880000 {
+			label = "tclinux_alt";
+			reg = <0x2880000 0x2620000>;
+			read-only;
+		};
+
+		partition@4ea0000 {
+			label = "wwan";
+			reg = <0x4ea0000 0x100000>;
+		};
+
+		partition@4fa0000 {
+			label = "factory_data";
+			reg = <0x4fa0000 0x400000>;
+		};
+
+		partition@53a0000 {
+			label = "rom-d";
+			reg = <0x53a0000 0x100000>;
+		};
+
+		partition@54a0000 {
+			label = "misc";
+			reg = <0x54a0000 0x2000000>;
+		};
+
+		factory: partition@74a0000 {
+			label = "factory";
+			reg = <0x74a0000 0x80000>;
+		};
+
+		partition@7520000 {
+			label = "reservearea";
+			reg = <0x7520000 0xc0000>;
+		};
+	};
+};
+
+&pcie0 {
+	status = "okay";
+};
+
+&slot0 {
+	status = "okay";
+
+	wifi@0,0 {
+		compatible = "mediatek,mt76";
+		reg = <0x0000 0 0 0 0>;
+		mediatek,mtd-eeprom = <&factory 0x0000>;
+		big-endian;
+	};
+};
+
+&pcie1 {
+	status = "okay";
+
+	/* Slot 1 is a second link to the same wifi chip */
+};
+
+&ethernet {
+	status = "okay";
+};
+
+&gmac0 {
+	status = "okay";
+};
+
+&switch {
+	status = "okay";
+};
+
+&gsw_port1 {
+	status = "okay";
+	label = "lan1";
+};
+
+&gsw_port0 {
+	status = "okay";
+	label = "lan2";
+};
+
+&gsw_phy1_led0 {
+	color = <LED_COLOR_ID_GREEN>;
+	function = LED_FUNCTION_LAN;
+	function-enumerator = <1>;
+	status = "okay";
+};
+
+&gsw_phy0_led0 {
+	color = <LED_COLOR_ID_GREEN>;
+	function = LED_FUNCTION_LAN;
+	function-enumerator = <2>;
+	status = "okay";
+};
+
+
diff --git a/target/linux/econet/image/en751627.mk b/target/linux/econet/image/en751627.mk
index 4fcd6d4c90..b6f56023e3 100644
--- a/target/linux/econet/image/en751627.mk
+++ b/target/linux/econet/image/en751627.mk
@@ -10,4 +10,14 @@ define Device/zyxel_ex3301-t0
   IMAGE/sysupgrade.bin := append-kernel | lzma | tclinux-trx | append-metadata
   DEVICE_PACKAGES := kmod-usb3 kmod-econet-eth kmod-mt7915e kmod-mt7915-firmware
 endef
-TARGET_DEVICES += zyxel_ex3301-t0
+define Device/zyxel_wx3100-t0
+  DEVICE_VENDOR := Zyxel
+  DEVICE_MODEL := WX3100-T0
+  DEVICE_DTS := en751627_zyxel_wx3100-t0
+  SUPPORTED_DEVICES := zyxel,wx3100-t0
+  IMAGES := tclinux.trx sysupgrade.bin
+  IMAGE/tclinux.trx := append-kernel | lzma | tclinux-trx
+  IMAGE/sysupgrade.bin := append-kernel | lzma | tclinux-trx | append-metadata
+  DEVICE_PACKAGES := kmod-usb3 kmod-econet-eth kmod-mt7915e kmod-mt7915-firmware
+endef
+TARGET_DEVICES += zyxel_ex3301-t0 zyxel_wx3100-t0
-- 
2.55.0

